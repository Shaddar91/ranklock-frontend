{
  "name": "ranklock-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/strip-metered-bindings.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "type-check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node scripts/no-slop-check.mjs && npm run gate",
    "lint:fix": "eslint . --fix",
    "gate": "node scripts/staged-post-check.mjs",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "preview:cf": "wrangler dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@tanstack/react-query": "^5.101.0",
    "astro": "^6.4.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.16.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.83.0"
  }
}
