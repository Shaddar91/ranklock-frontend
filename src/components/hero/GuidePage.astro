---
//Shared renderer for the hero guide family: the canonical /heroes/<slug>/guide/ page (no token)
//and each archetype sibling /heroes/<slug>/guide/<token>/. One fetch+model+spine; the token
//forks the title/H1, breadcrumb, chips, JSON-LD isPartOf, the role nav and the H2 guard.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameArt from '../GameArt.astro';
import Narrative from '../Narrative.astro';
import WinRate from '../WinRate.astro';
import GuideLiveStats from '../react/GuideLiveStats';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { api } from '../../lib/apiClient';
import { buildFetch } from '../../lib/buildData';
import { breadcrumbJsonLd, SITE_NAME } from '../../lib/seo';
import { count, shortDate } from '../../lib/format';
import { abilityOrderSequence, favoriteCounts, formatUpdated } from '../../lib/buildMeta';
import { isPublicItem, itemMeta } from '../../lib/itemCatalog';
import { heroArt } from '../../lib/heroArt';
import { heroPath } from '../../lib/heroSlugs';
import { itemPath } from '../../lib/itemSlugs';
import { about } from '../../lib/heroNarrative';
import { pagePath } from '../../lib/i18n';
import { BUILD_DISPLAY, parseGuideId, type BuildToken, type PublishedGuide } from '../../lib/guideIds';
import {
  buildHeroPlay,
  roleHeadingText,
  ROLE_LABEL,
  type AbilityDescription,
  type GuideMeta,
  type HeroRole,
  printableSectionLabel,
} from '../../lib/heroPlay';
import type {
  DataHorizonResponse,
  HeroAbility,
  HeroCounterRow,
  HeroItemWinRate,
  HeroSummary,
  HeroSynergyRow,
  MatchupEntry,
  Patch,
  ScoredBuild,
} from '../../types/api';

interface Props {
  hero: HeroSummary;
  roster: HeroSummary[];
  entry: CollectionEntry<'guides'>;
  token?: string;
  siblings: PublishedGuide[];
}

//The fixed archetype skeleton (no role H2s) — the canonical route's role-H2 guard is replaced
//by this check on archetype pages.
const ARCHETYPE_H2 = [
  'What this build buys, tier by tier',
  'Ability order for this build',
  'When to pick this over the standard build',
  'Matchups this build changes',
  'The numbers behind this build',
];

const { hero, roster, entry, siblings } = Astro.props;
const token = Astro.props.token ?? null;
const display = token !== null ? (BUILD_DISPLAY[token as BuildToken] ?? token) : null;
const name = hero.hero_name;

const { Content, headings } = await render(entry);

const norm = (s: string): string => s.trim().toLowerCase();
const ROLE_TOKENS: readonly HeroRole[] = ['support', 'damage', 'tank', 'offensive', 'jungle'];

const where = `src/content/guides/${entry.id}.md`;
if (entry.data.heroSlug !== parseGuideId(entry.id).slug) {
  throw new Error(`[guide-slug guard] ${where}: heroSlug "${entry.data.heroSlug}" is not the file id "${entry.id}".`);
}
const h2 = headings.filter((h) => h.depth === 2).map((h) => norm(h.text));
if (token === null) {
  for (const role of entry.data.roles) {
    const want = roleHeadingText(entry.data.hero, role);
    if (!h2.includes(norm(want))) {
      throw new Error(`[guide-role guard] ${where}: declares "${role}" but carries no H2 "${want}".`);
    }
  }
  const declared = new Set<string>(entry.data.roles);
  for (const role of ROLE_TOKENS) {
    if (!declared.has(role) && h2.includes(norm(roleHeadingText(entry.data.hero, role)))) {
      console.warn(`[guide-role guard] ${where}: carries the H2 for "${role}", which its front matter does not declare.`);
    }
  }
} else {
  for (const want of ARCHETYPE_H2) {
    if (!h2.includes(norm(want))) {
      throw new Error(`[guide-skeleton guard] ${where}: an archetype guide must carry the H2 "${want}".`);
    }
  }
}
//The roster is a build-time fetch that falls back to [] on timeout, so an unguarded subset
//check would fail every guide on a cold build — turning a degraded build into a broken one.
if (roster.length > 0) {
  const rosterNames = new Set(roster.map((h) => norm(h.hero_name)));
  for (const opponent of entry.data.counters) {
    if (!rosterNames.has(norm(opponent))) {
      throw new Error(`[guide-counters guard] ${where}: counters names "${opponent}", which is not on the released roster.`);
    }
  }
}

const [abilityRows, buildRows, matchupRows, counterRows, synergyRows, itemRows, horizon, patches] = await Promise.all([
  buildFetch(api.getHeroAbilities(hero.hero_id), [] as HeroAbility[]),
  buildFetch(api.getHeroBuilds(hero.hero_id, 'weekly', true), [] as ScoredBuild[]),
  buildFetch(api.getHeroMatchups(hero.hero_id), [] as MatchupEntry[]),
  buildFetch(api.getHeroCounters(hero.hero_id), [] as HeroCounterRow[]),
  buildFetch(api.getHeroSynergies(hero.hero_id), [] as HeroSynergyRow[]),
  buildFetch(api.getHeroItemWinRates(hero.hero_id), [] as HeroItemWinRate[]),
  buildFetch(api.getDataHorizon(), null as DataHorizonResponse | null),
  buildFetch(api.getPatches(), [] as Patch[]),
]);

const currentPatch = patches.find((p) => p.is_current) ?? null;
const guide: GuideMeta = {
  hero: entry.data.hero,
  roles: entry.data.roles,
  counters: entry.data.counters,
  synergyItems: entry.data.synergyItems,
  buildIds: entry.data.buildIds,
  patchLabel: entry.data.patchLabel,
  sources: entry.data.sources,
  draft: entry.data.draft,
  pubDate: entry.data.pubDate,
  updatedDate: entry.data.updatedDate ?? null,
};

const play = buildHeroPlay({
  hero,
  abilities: abilityRows,
  builds: buildRows,
  matchups: matchupRows,
  counters: counterRows,
  synergies: synergyRows,
  items: itemRows,
  horizon,
  currentPatch,
  guide,
  headings,
});

//Ability text arrives as upstream HTML — inline <svg>/<img>/<span class="highlight">/<br>.
//It is rendered as text, so the markup is stripped rather than trusted into the document.
const ENTITIES: Record<string, string> = { amp: '&', lt: '<', gt: '>', quot: '"', apos: "'", nbsp: ' ', '#39': "'" };
const plain = (html: string | null | undefined): string =>
  (html ?? '')
    .replace(/<svg[\s\S]*?<\/svg>/gi, '')
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/<[^>]*>/g, '')
    .replace(/&(#?\w+);/g, (m, e: string) => ENTITIES[e.toLowerCase()] ?? m)
    .replace(/\s+/g, ' ')
    .trim();

const UPGRADE_KEYS: readonly [keyof AbilityDescription, string][] = [
  ['t1_desc', 'Upgrade 1'],
  ['t2_desc', 'Upgrade 2'],
  ['t3_desc', 'Upgrade 3'],
];

//The four signature abilities; a hero whose feed names none keeps the full track (buildModel's
//imbueAbilities fallback), never an empty section.
const signature = play.abilities.filter((a) => a.slot.startsWith('signature'));
const abilities = (signature.length > 0 ? signature : play.abilities).map((a) => ({
  ...a,
  body: plain(a.description?.desc),
  upgrades: UPGRADE_KEYS.map(([key, label]) => ({ label, text: plain(a.description?.[key]) })).filter((u) => u.text !== ''),
}));

const abilityName = new Map(play.abilities.map((a) => [a.id, a.name]));
const levelling = abilityOrderSequence(play.builds[0]?.build.ability_order)
  .map((id) => abilityName.get(id))
  .filter((n): n is string => n != null);

const nowSeconds = Math.floor(Date.now() / 1000);
const topWeeklyFav = Math.max(0, ...buildRows.map((b) => b.num_weekly_favorites ?? 0));
//§1.7 fallback for a suppressed name: cite the build by its standing, its author and its favorites.
const builds = play.builds.map(({ build, author, cited, name: printName }) => ({
  name:
    printName ??
    ((build.num_weekly_favorites ?? 0) > 0 && (build.num_weekly_favorites ?? 0) >= topWeeklyFav
      ? `The most favorited published ${name} build`
      : `A published ${name} build`),
  author,
  cited,
  updated: formatUpdated(build.last_updated_timestamp, nowSeconds),
  favorites: favoriteCounts(build),
  categories: build.categories.map((c, i) => ({
    label: printableSectionLabel(c.name) ? c.name : `Section ${i + 1}`,
    items: c.items.flatMap((i) => {
      const meta = isPublicItem(i.item_id) ? itemMeta(i.item_id) : undefined;
      return meta ? [{ id: i.item_id as number, name: meta.name, icon: meta.icon }] : [];
    }),
  })),
}));

const heroById = new Map(roster.map((h) => [h.hero_id, h]));
const counters = play.hardCounters.map((c) => ({ ...c, opponent: heroById.get(c.enemy) ?? null }));

const windowOf = (ds: string) => horizon?.datasets.find((d) => d.dataset === ds);
const windowLo = windowOf('hero-matchups')?.window_lo ?? windowOf('hero-item-win-rates')?.window_lo ?? null;
const windowHi = windowOf('hero-matchups')?.window_hi ?? windowOf('hero-item-win-rates')?.window_hi ?? null;
const statsThrough = shortDate(horizon?.max_match_start_time);
const provenance = {
  ...about({
    hero,
    counters: counterRows,
    statsThrough,
    window: windowLo && windowHi ? { lo: shortDate(windowLo), hi: shortDate(windowHi) } : null,
    patchesInWindow:
      windowLo && windowHi ? patches.filter((p) => p.released_at >= windowLo && p.released_at <= windowHi).length : null,
    currentPatch: currentPatch ? { label: currentPatch.version_label, since: shortDate(currentPatch.released_at) } : null,
  }),
  heading: 'Where these numbers come from',
};

const hasServed = builds.length > 0 || abilities.length > 0 || counters.length > 0 || play.items.length > 0;
const hasLive = entry.data.liveHeroes.length > 0 || entry.data.liveItems.length > 0;

const heroUrl = heroPath(name);
const buildUrl = `${heroUrl}build/`;
const canonicalGuidePath = pagePath(`${heroUrl}guide`);
const canonicalPath = token !== null ? pagePath(`${heroUrl}guide/${token}`) : canonicalGuidePath;
const art = heroArt(hero.icon_url);
const title =
  token !== null ? entry.data.title : `${name} guide: how to play ${name} on the ${entry.data.patchLabel} patch`;
const description = entry.data.description;
const written = shortDate((entry.data.updatedDate ?? entry.data.pubDate).toISOString());

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const pageUrl = new URL(canonicalPath, origin).toString();
//Entity markup: the page is an Article ABOUT a named hero inside a named game, so a search
//engine can attach it to both entities instead of reading 2,000 words of loose text.
const jsonLd = [
  breadcrumbJsonLd(origin, [
    { name: 'Home', path: '/' },
    { name: 'Heroes', path: '/heroes' },
    { name, path: heroUrl },
    { name: 'How to play', path: canonicalGuidePath },
    ...(display !== null ? [{ name: `${display} build`, path: canonicalPath }] : []),
  ]),
  {
    '@type': 'Article',
    headline: title,
    description,
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
    author: { '@type': 'Organization', name: entry.data.author },
    publisher: { '@type': 'Organization', name: SITE_NAME, url: origin },
    mainEntityOfPage: pageUrl,
    inLanguage: 'en',
    ...(art?.card ? { image: art.card } : {}),
    keywords:
      display !== null
        ? [`${name} ${display.toLowerCase()} build`, `${name} guide`, 'Deadlock'].join(', ')
        : [`${name} guide`, `how to play ${name}`, `${name} build`, 'Deadlock'].join(', '),
    about: [
      {
        '@type': 'VideoGame',
        name: 'Deadlock',
        publisher: { '@type': 'Organization', name: 'Valve' },
        gamePlatform: 'PC',
      },
      {
        '@type': 'Thing',
        name,
        url: new URL(heroUrl, origin).toString(),
        description: `${name} is a playable hero in Deadlock.`,
      },
    ],
    isPartOf:
      token !== null
        ? { '@type': 'Article', url: new URL(canonicalGuidePath, origin).toString() }
        : { '@type': 'WebSite', name: SITE_NAME, url: origin },
  },
];

const siblingLabel = (s: PublishedGuide): string =>
  s.token === null ? `How to play ${name}` : `${name} ${BUILD_DISPLAY[s.token as BuildToken] ?? s.token} build`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  image={art?.card ?? entry.data.heroImage}
  backdropHero={art?.cls}
>
  <main class="container">
    <nav class="kicker" style="margin-bottom:14px; display:flex; gap:12px; flex-wrap:wrap;">
      <a href="/heroes/" style="color:var(--muted);">← All heroes</a>
      <a href={heroUrl} style="color:var(--muted);">{name} stats</a>
      <a href={buildUrl} style="color:var(--muted);">{name} build</a>
      <a href="/guides/" style="color:var(--muted);">All hero guides</a>
    </nav>

    <div class="entity-head">
      <GameArt name={name} src={hero.icon_url} wrapClass="entity-art" fontSize={32} eager />
      <div class="hero-head-text">
        <div class="kicker">{display !== null ? `${display} build · Deadlock` : 'How to play · Deadlock'}</div>
        <h1 class="h-page">{display !== null ? `${name} ${display} build` : `How to play ${name}`}</h1>
        <div class="flex" style="gap:6px; flex-wrap:wrap; margin-top:6px;">
          {display !== null ? <span class="chip">{display} build</span> : entry.data.roles.map((role) => <span class="chip">{ROLE_LABEL[role]}</span>)}
        </div>
      </div>
    </div>

    <p class="page-intro">
      {play.window}
      <br />Written for the {entry.data.patchLabel} patch, updated {written}.
    </p>

    {
      token === null && play.roleNav.length > 0 && (
        <div class="gp-choose">
          <div class="label-xs" style="margin-bottom:6px;">Choose how to play</div>
          <nav class="tabs" aria-label="Choose how to play">
            {play.roleNav.map((r) => (
              <a class="tab" href={`#${r.anchor}`}>{r.label}</a>
            ))}
          </nav>
        </div>
      )
    }

    {
      siblings.length > 0 && (
        <div class="gp-choose">
          <div class="label-xs" style="margin-bottom:6px;">{token !== null ? 'More ways to play' : 'Also'}</div>
          <nav class="tabs" aria-label={`More ${name} guides`}>
            {siblings.map((s) => (
              <a class="tab" href={s.path}>{siblingLabel(s)}</a>
            ))}
          </nav>
        </div>
      )
    }

    <div class="gp-cols">
    <div class="gp-main">
    <section class="panel panel-pad gp-body">
      <div class="prose"><Content /></div>
    </section>
    </div>

    <aside class="gp-rail">
    {
      hasLive && (
        <div class="panel panel-pad" style="margin-bottom:24px;">
          <div class="label-xs" style="margin-bottom:10px;">Live stats in this guide</div>
          <GuideLiveStats heroes={entry.data.liveHeroes} items={entry.data.liveItems} client:visible />
        </div>
      )
    }

    {
      builds.length > 0 && (
        <section class="panel panel-pad" style="margin-bottom:24px;">
          <div class="between" style="margin-bottom:10px; gap:16px; flex-wrap:wrap;">
            <h2 class="h-sec" style="margin:0;">The build</h2>
            <a class="kicker" href={buildUrl}>All {name} builds and item sets →</a>
          </div>
          <ul style="list-style:none; margin:0; padding:0; display:grid; gap:16px;">
            {builds.map((b) => (
              <li>
                <div class="between" style="gap:12px; flex-wrap:wrap;">
                  <span class="display" style="font-weight:600; color:var(--text);">{b.name}</span>
                  <span class="mono" style="font-size:12px; color:var(--muted);">by {b.author}</span>
                </div>
                <div class="mono" style="font-size:12px; color:var(--muted); margin-top:4px;">
                  {b.favorites.map((f) => <span style="margin-right:10px;">{count(f.value)} {f.label}</span>)}
                  <span>Updated {b.updated}</span>
                  {b.cited && <span style="margin-left:10px; color:var(--gold);">Cited in this guide</span>}
                </div>
                {b.categories.map((c) => (
                  c.items.length > 0 && (
                    <div style="margin-top:8px;">
                      <span class="label-xs">{c.label}</span>
                      <span class="bp-set" style="margin-top:4px;">
                        {c.items.map((i) => (
                          <a class="bp-chip" href={itemPath(i.id)}>
                            <GameArt name={i.name} src={i.icon} wrapClass="iicon" wrapStyle="width:22px; height:22px;" />
                            <span>{i.name}</span>
                          </a>
                        ))}
                      </span>
                    </div>
                  )
                ))}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      abilities.length > 0 && (
        <section class="panel panel-pad" style="margin-bottom:24px;">
          <h2 class="h-sec" style="margin-bottom:10px;">Abilities and levelling order</h2>
          <ul style="list-style:none; margin:0; padding:0; display:grid; gap:16px;">
            {abilities.map((a) => (
              <li>
                <div class="flex" style="align-items:center; gap:10px;">
                  <GameArt name={a.name} src={a.iconUrl} wrapClass="iicon" wrapStyle="width:32px; height:32px;" />
                  <span class="display" style="font-weight:600; color:var(--text);">{a.name}</span>
                  <span class="label-xs">{a.slot}</span>
                </div>
                {a.body !== '' && (
                  <p class="muted" style="font-size:14px; line-height:1.65; margin:6px 0 0;">{a.body}</p>
                )}
                {a.upgrades.length > 0 && (
                  <ul style="list-style:none; margin:6px 0 0; padding:0; display:grid; gap:4px;">
                    {a.upgrades.map((u) => (
                      <li class="muted" style="font-size:13px; line-height:1.55;">
                        <span class="label-xs" style="margin-right:6px;">{u.label}</span>{u.text}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
          {
            levelling.length > 0 && (
              <p class="muted" style="font-size:14px; line-height:1.65; margin:14px 0 0;">
                Levelling order in the most-favourited build: {levelling.join(' → ')}.
              </p>
            )
          }
        </section>
      )
    }

    {
      counters.length > 0 && (
        <section class="panel panel-pad" style="margin-bottom:24px;">
          <h2 class="h-sec" style="margin-bottom:10px;">Counters by win rate</h2>
          <div class="dt-scroll">
            <table class="dt">
              <thead>
                <tr>
                  <th><span class="th-static">Opponent</span></th>
                  <th class="num"><span class="th-static">{name} win rate</span></th>
                  <th class="num"><span class="th-static">Matches</span></th>
                </tr>
              </thead>
              <tbody>
                {counters.map((c) => (
                  <tr>
                    <td>
                      <span class="flex" style="align-items:center; gap:10px;">
                        <GameArt
                          name={c.opponent?.hero_name ?? `Hero ${c.enemy}`}
                          src={c.opponent?.icon_url}
                          wrapClass="hav"
                          wrapStyle="width:28px; height:28px;"
                        />
                        {c.opponent ? (
                          <a href={heroPath(c.opponent.hero_name)} class="display" style="font-weight:600;">
                            vs {c.opponent.hero_name}
                          </a>
                        ) : (
                          <span class="display" style="font-weight:600; color:var(--text);">vs Hero {c.enemy}</span>
                        )}
                      </span>
                    </td>
                    <td class="num"><WinRate wr={c.winRate} /></td>
                    <td class="num"><span class="tnum">{count(c.matches)}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="muted" style="font-size:13px; margin:8px 0 0;">
            The worst matchups RankLock's own matches measured, over a minimum-sample floor. Every
            opponent is on <a href={heroUrl}>{name}'s stats page</a>.
          </p>
        </section>
      )
    }

    {
      play.items.length > 0 && (
        <section class="panel panel-pad" style="margin-bottom:24px;">
          <div class="between" style="margin-bottom:10px; gap:16px; flex-wrap:wrap;">
            <h2 class="h-sec" style="margin:0;">Items by win rate</h2>
            <a class="kicker" href={buildUrl}>Every {name} item →</a>
          </div>
          <div class="dt-scroll">
            <table class="dt">
              <thead>
                <tr>
                  <th><span class="th-static">Item</span></th>
                  <th class="num"><span class="th-static">Win rate</span></th>
                  <th class="num"><span class="th-static">Games</span></th>
                </tr>
              </thead>
              <tbody>
                {play.items.map((i) => (
                  <tr>
                    <td>
                      <a class="flex" href={itemPath(i.id)} style="align-items:center; gap:10px; text-decoration:none;">
                        <GameArt name={i.name} src={i.iconUrl} wrapClass="iicon" wrapStyle="width:26px; height:26px;" />
                        <span class="display" style="font-weight:600; color:var(--text);">{i.name}</span>
                        {i.cited && <span class="chip">In this guide</span>}
                      </a>
                    </td>
                    <td class="num"><WinRate wr={i.winRate} /></td>
                    <td class="num"><span class="tnum">{count(i.games)}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {!hasServed && <p class="page-intro">No play data was available for {name} when this page was built.</p>}

    <Narrative sections={[provenance]} />

    <p class="page-intro">
      For win rate, matchups and duo partners see <a href={heroUrl}>{name}'s stats page</a>; for the
      measured item sets and buy order see <a href={buildUrl}>{name}'s build page</a>.
    </p>
    </aside>
    </div>
  </main>
</BaseLayout>

<style>
  /* Anchor targets sit under the sticky site header; the nav itself is plain links, no JS. */
  .gp-choose {
    margin-bottom: 24px;
  }
  .gp-choose .tab {
    text-decoration: none;
  }
  .gp-body :global(h2) {
    scroll-margin-top: 84px;
  }
  /* the guide reads in a main column with its numbers, build and counters in a rail, as the item page does */
  .gp-cols {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(300px, 5fr);
    gap: 22px;
    align-items: start;
  }
  .gp-rail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    min-width: 0;
  }
  .gp-rail > :global(*) {
    margin-bottom: 0 !important;
  }
  .gp-body :global(.prose) {
    max-width: 100%;
  }
  @media (max-width: 960px) {
    .gp-cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
