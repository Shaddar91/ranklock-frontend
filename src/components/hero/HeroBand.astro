---
//Hero §1 — the identity band: framed portrait, title block, the five metric cards in the
//right column and the tab strip flush beneath them. Shared by Overview and Build.
import StatTile from '../react/ui/StatTile';
import TierPill from '../react/ui/TierPill';
import { count, duration, fixed, kda, metaTier, pct } from '../../lib/format';
import { heroArt } from '../../lib/heroArt';
import { plainText } from '../../lib/heroKit';
import { TIER_COLOR } from '../../lib/ranks';
import type { HeroAssetsResponse, HeroSummary } from '../../types/api';

interface Props {
  hero: HeroSummary;
  assets: HeroAssetsResponse | null;
  patchRank: number;
  rosterSize: number;
  pickRate: number | null;
  tabs: { label: string; href: string; current: boolean }[];
}

const { hero, assets, patchRank, rosterSize, pickRate, tabs } = Astro.props;
const name = hero.hero_name;
const art = heroArt(hero.icon_url);
const tier = metaTier(hero.win_rate);
const tierScale = Object.keys(TIER_COLOR).join(' · ');
const heroKda = kda(hero.avg_kills, hero.avg_deaths, hero.avg_assists);
const tags = Array.isArray(assets?.tags) ? (assets?.tags as string[]) : [];
//The kicker carries the archetype; the served tag list leads with it, so the chips take the rest.
const archetype = tags[0] ?? null;
const chipTags = tags.slice(1);
//Upstream blurbs carry inline markup (<i>…</i> on sinclair); strip it rather than print it.
const blurb = plainText(assets?.description?.playstyle);
const monogram = name.slice(0, 2).toUpperCase();
---

<section class="hero-band">
  {art && <img class="hero-band-art" src={art.background} alt="" aria-hidden="true" />}
  <div class="hero-band-inner">
    <div class="hero-portrait">
      <span class="hero-portrait-mono" aria-hidden="true">{monogram}</span>
      {
        art && (
          <img
            src={art.card}
            alt={name}
            width="200"
            height="240"
            loading="eager"
            fetchpriority="high"
            data-fallback={art.cardGloat}
            onerror="if(this.src!==this.dataset.fallback){this.src=this.dataset.fallback}else{this.onerror=null;this.style.display='none'}"
          />
        )
      }
      <span class="corner tl"></span>
      <span class="corner br"></span>
    </div>

    <div class="hero-band-col">
      <div class="hero-band-top">
        <div class="hero-band-text">
          <div class="kicker">
            Hero{archetype ? ` · ${archetype}` : ''}
            {patchRank > 0 ? ` · #${patchRank} of ${rosterSize} this patch` : ''}
          </div>
          <h1 class="h-hero">{name}</h1>
          {blurb && <p class="hero-blurb">{blurb}</p>}
          <div class="hero-tags">
            {chipTags.map((t) => <span class="chip">{t}</span>)}
            {
              typeof assets?.complexity === 'number' && (
                <span class="chip">
                  Complexity
                  <span class="cxdots">
                    {[1, 2, 3].map((d) => <i class={d <= (assets.complexity as number) ? 'on' : ''} />)}
                  </span>
                </span>
              )
            }
          </div>
        </div>

        <div class="hero-tiles">
          <StatTile variant="band" label="Win rate" value={pct(hero.win_rate)}>
            {
              hero.delta_win_rate_7d != null && (
                <Fragment slot="trend">
                  <span class={hero.delta_win_rate_7d >= 0 ? 'win-c' : 'loss-c'}>
                    {hero.delta_win_rate_7d >= 0 ? '▲' : '▼'} {Math.abs(hero.delta_win_rate_7d).toFixed(1)}
                  </span>
                </Fragment>
              )
            }
            <Fragment slot="sub">vs 7 days ago</Fragment>
          </StatTile>
          <StatTile variant="band" label="Matches" value={count(hero.picks)}>
            <Fragment slot="sub">pick rate {pickRate == null ? '—' : `${pickRate.toFixed(1)}%`}</Fragment>
          </StatTile>
          <StatTile variant="band" label="KDA" value={fixed(heroKda, 1)}>
            <Fragment slot="sub">
              {fixed(hero.avg_kills, 1)} / {fixed(hero.avg_deaths, 1)} / {fixed(hero.avg_assists, 1)}
            </Fragment>
          </StatTile>
          <StatTile variant="band" label="Avg souls" value={count(hero.avg_net_worth)}>
            <Fragment slot="sub">per {duration(hero.avg_duration_s)} match</Fragment>
          </StatTile>
          <StatTile variant="band" label="Meta tier" value="">
            <TierPill slot="value" tier={tier ?? '—'} />
            <Fragment slot="sub">of {tierScale}</Fragment>
          </StatTile>
        </div>
      </div>

      <nav class="tabs hero-tabs" aria-label="Hero sections">
        {
          tabs.map((t) => (
            <a class={t.current ? 'tab on' : 'tab'} href={t.href} aria-current={t.current ? 'page' : undefined}>
              {t.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>
