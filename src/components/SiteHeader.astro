---
//Site-wide sticky nav (C4) — shared internal-linking chrome for the SEO surface.
//Brand mark + primary nav are STATIC Astro markup (server-rendered, no JS, good
//for crawlers); only the genuinely interactive bits are islands: the player
//SearchBox and the foundry⇄arcane ThemeSwitcher (both client:load — the eslint
//client:* guard enforces the directive).
import SearchBox from './react/SearchBox';
import ThemeSwitcher from './react/ThemeSwitcher';

const links = [
  { href: '/heroes', label: 'Heroes' },
  { href: '/items', label: 'Items' },
  { href: '/patches', label: 'Patches' },
  { href: '/build-lab', label: 'Build Lab' },
  { href: '/lane-lab', label: 'Lane Lab' },
  { href: '/leaderboard', label: 'Leaderboard' },
  { href: '/matches', label: 'Matches' },
  { href: '/blog', label: 'Guides' },
  { href: '/support', label: 'Support' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path === href + '/' || path.startsWith(href + '/');
---

<header class="nav">
  <div class="nav-inner">
    <a class="wordmark" href="/" aria-label="RankLock home">
      <svg class="wm-mark" width="34" height="34" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="brassNav" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#e8c987"></stop>
            <stop offset=".5" stop-color="#c79a4e"></stop>
            <stop offset="1" stop-color="#6b4a21"></stop>
          </linearGradient>
        </defs>
        <path d="M20 2 35 7v12c0 9-7 15-15 19C12 34 5 28 5 19V7L20 2Z" fill="#10151e" stroke="url(#brassNav)" stroke-width="2"></path>
        <path d="M20 7l9 3v8.5c0 6-4.5 10.5-9 13" stroke="var(--cyan-bright)" stroke-width="1.2" opacity=".55" fill="none"></path>
        <circle cx="20" cy="17" r="4" fill="none" stroke="url(#brassNav)" stroke-width="2.2"></circle>
        <path d="M20 20.5 18.5 28h3L20 20.5Z" fill="url(#brassNav)"></path>
        <path d="M14 13.5 20 11l6 2.5" stroke="var(--cyan-bright)" stroke-width="1.6" stroke-linecap="round" fill="none"></path>
      </svg>
      <span class="wm-text">Rank<b>Lock</b></span>
    </a>

    <details class="nav-disc">
      <summary class="nav-burger" aria-label="Menu">
        <svg
          class="burger-ico"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </summary>

      <div class="nav-drawer">
        <nav class="flex nav-links" aria-label="Primary">
          {
            links.map((l) => (
              <a
                class={'navlink' + (isActive(l.href) ? ' active' : '')}
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            ))
          }
        </nav>

        <div class="nav-tools flex">
          <SearchBox variant="compact" client:load />
          <ThemeSwitcher compact client:load />
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  /*Narrow-width disclosure: <=768px the links+tools collapse behind the hamburger; desktop stays one row via display:contents.*/
  .nav-disc {
    display: contents;
  }
  .nav-disc > .nav-burger {
    display: none;
  }
  .nav-drawer {
    display: contents;
  }
  /*Load-bearing: reveals the closed <details> content on desktop (modern UAs hide this pseudo; older UAs use display:contents above).*/
  .nav-disc::details-content {
    display: contents;
    content-visibility: visible;
  }

  @media (max-width: 768px) {
    .nav-disc {
      display: block;
      position: relative;
      margin-left: auto;
    }
    .nav-disc > .nav-burger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: 1px solid var(--border);
      border-radius: var(--r-pill);
      background: var(--surface);
      color: var(--text);
      cursor: pointer;
      list-style: none;
    }
    .nav-disc > .nav-burger::-webkit-details-marker {
      display: none;
    }
    .nav-disc > .nav-burger:hover {
      background: var(--raised);
      border-color: var(--cyan);
    }
    .nav-disc[open] > .nav-burger {
      border-color: var(--cyan);
      color: var(--cyan-bright);
    }

    .nav-drawer {
      display: none;
    }
    .nav-disc[open] .nav-drawer {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: max-content;
      min-width: 200px;
      max-width: calc(100vw - 24px);
      padding: 8px;
      border-radius: var(--r-card);
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: 0 18px 48px -16px rgba(0, 0, 0, 0.7);
      max-height: calc(100dvh - 72px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .nav-disc[open] .nav-links {
      flex-direction: column;
      align-items: stretch;
      flex: 0 0 auto;
      margin-left: 0;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .nav-disc[open] .nav-links .navlink {
      padding: 9px 12px;
      font-size: 14px;
    }
    .nav-disc[open] .nav-tools {
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 4px;
      padding-top: 8px;
      border-top: 1px solid var(--border);
    }
  }
</style>
