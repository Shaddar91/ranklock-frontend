---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TrackingProvider from '../components/react/TrackingProvider';
import ConsentBanner from '../components/react/ConsentBanner';
import { resolveLocale } from '../lib/i18n';

//Base HTML frame + the gaslamp design system (C3) + the SEO meta layer (per-route
//C4 + cross-cutting locale infra C7, both via <Seo>). Site chrome (sticky nav +
//footer) wraps the page slot unless a page opts out with `chrome={false}` (e.g.
//the /styleguide demo). <html lang> + hreflang + the untranslated-locale
//noindex/canonical policy are driven by Astro.currentLocale (set from the URL
//prefix by the i18n routing in astro.config.mjs); lib/i18n is the source of
//truth. Pages can still inject per-route <link> tags via the named `head` slot.
//Default skin is `foundry` (lib/theme).
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalPath?: string;
  image?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  //render the shared nav + footer (default true).
  chrome?: boolean;
}

//Current locale from the URL (en at root, /ru/… etc.). Fallback-rewritten pages
//(/ru/heroes …) report their prefix locale here, so <html lang> + the SEO layer
//localize automatically with no per-page wiring.
const currentLocale = resolveLocale(Astro.currentLocale);

const {
  title = 'RankLock — Deadlock stats & guides',
  description,
  //<html lang> defaults to the route's locale (BCP-47 tag); a page may override.
  lang = currentLocale.hreflang,
  canonicalPath,
  image,
  ogType,
  jsonLd,
  noindex = false,
  publishedTime,
  modifiedTime,
  chrome = true,
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="foundry">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      ogType={ogType}
      jsonLd={jsonLd}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      locale={currentLocale.code}
    />

    <!-- gaslamp display/mono fonts (Chakra Petch / Cinzel / JetBrains Mono). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Cinzel:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <slot name="head" />
    <script is:inline>
      //Apply the persisted skin + art-direction tweaks before first paint to avoid
      //a flash. Mirrors lib/theme (data-theme) + lib/tweaks (the data-* contract +
      //the --cyan-* HUD accent); kept inline + duplicated because is:inline scripts
      //cannot import a module — keep these tables in sync with lib/tweaks.ts.
      (() => {
        try {
          const el = document.documentElement;
          const get = (k) => {
            try {
              return localStorage.getItem(k);
            } catch {
              return null;
            }
          };
          //theme (data-theme) — default 'foundry' already on <html>.
          const themes = ['foundry', 'arcane', 'aether', 'gaslamp', 'obsidian'];
          const t = get('ranklock-theme');
          const activeTheme = t && themes.includes(t) ? t : 'foundry';
          if (t && themes.includes(t)) el.dataset.theme = t;
          //enum tweaks → data-* attributes (always set, default included).
          const tweaks = [
            ['ranklock-atmos', 'data-atmos', ['hero', 'off'], 'hero'],
            ['ranklock-promo', 'data-promo', ['on', 'off'], 'on'],
            ['ranklock-brass', 'data-brass', ['bold', 'minimal'], 'bold'],
            ['ranklock-density', 'data-density', ['compact', 'regular', 'comfy'], 'regular'],
            ['ranklock-table', 'data-table', ['zebra', 'plain', 'lined'], 'zebra'],
            ['ranklock-badge', 'data-badge', ['full', 'emblem-only', 'label-only'], 'full'],
            ['ranklock-radar', 'data-radar', ['filled', 'line'], 'filled'],
          ];
          for (const [key, attr, valid, def] of tweaks) {
            const v = get(key);
            el.setAttribute(attr, v && valid.includes(v) ? v : def);
          }
          //HUD accent → --cyan-* overrides, only while Aether is active.
          const accents = {
            '#22d3ee': ['#22d3ee', '#06b6d4', '#0891b2', '#0e7490'],
            '#a78bfa': ['#a78bfa', '#8b5cf6', '#7c3aed', '#6d28d9'],
            '#fbbf24': ['#fbbf24', '#f59e0b', '#d97706', '#b45309'],
          };
          if (activeTheme === 'aether') {
            const raw = (get('ranklock-accent') || '').toLowerCase();
            const steps = accents[raw] || accents['#22d3ee'];
            ['--cyan-bright', '--cyan', '--cyan-deep', '--cyan-deeper'].forEach((p, i) =>
              el.style.setProperty(p, steps[i]),
            );
          }
        } catch {
          /* ignore storage access errors (private mode / disabled cookies) */
        }
      })();
    </script>
  </head>
  <body>
    <div class="app-bg" aria-hidden="true"></div>
    {chrome && <SiteHeader />}
    <slot />
    {chrome && <SiteFooter />}
    <!-- Consent + analytics layer (C6) — global on EVERY page (incl. chrome=false).
         TrackingProvider is behavior-only (renders null): consent-gated Matomo +
         SPA route-change pageviews + Consent Mode v2. ConsentBanner is the
         gaslamp cookie banner. Both are client:load (the eslint client:* guard
         enforces the directive). Nothing tracks / no ad script loads until the
         visitor accepts. -->
    <TrackingProvider client:load />
    <ConsentBanner client:load />
  </body>
</html>
