---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TrackingProvider from '../components/react/TrackingProvider';
import ConsentBanner from '../components/react/ConsentBanner';
import HeroBackdrop from '../components/react/HeroBackdrop';
import AdSlot from '../components/react/ui/AdSlot';
import { resolveLocale } from '../lib/i18n';
import { ATMOS, AD_SLOTS } from '../config/artDirection';

//Base HTML frame + the gaslamp design system (C3) + the SEO meta layer (per-route
//C4 + cross-cutting locale infra C7, both via <Seo>). Site chrome (sticky nav +
//footer) wraps the page slot unless a page opts out with `chrome={false}` (e.g.
//the /styleguide demo). <html lang> + hreflang + the untranslated-locale
//noindex/canonical policy are driven by Astro.currentLocale (set from the URL
//prefix by the i18n routing in astro.config.mjs); lib/i18n is the source of
//truth. Pages can still inject per-route <link> tags via the named `head` slot.
//Default skin is `foundry` (lib/theme).
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalPath?: string;
  image?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  //render the shared nav + footer (default true).
  chrome?: boolean;
  //pin the hero-art backdrop to one hero class (hero pages); unset => the rotating roster.
  backdropHero?: string;
}

//Current locale from the URL (en at root, /ru/… etc.). Fallback-rewritten pages
//(/ru/heroes …) report their prefix locale here, so <html lang> + the SEO layer
//localize automatically with no per-page wiring.
const currentLocale = resolveLocale(Astro.currentLocale);

const {
  title = 'RankLock — Deadlock stats & guides',
  description,
  //<html lang> defaults to the route's locale (BCP-47 tag); a page may override.
  lang = currentLocale.hreflang,
  canonicalPath,
  image,
  ogType,
  jsonLd,
  noindex = false,
  publishedTime,
  modifiedTime,
  chrome = true,
  backdropHero,
} = Astro.props;
---

<!doctype html>
<html
  lang={lang}
  data-theme="foundry"
  data-atmos={ATMOS}
  data-promo={AD_SLOTS}
  data-brass="bold"
  data-density="regular"
  data-table="zebra"
  data-badge="full"
  data-radar="filled"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-adsense-account" content="ca-pub-1123324309590777" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      ogType={ogType}
      jsonLd={jsonLd}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      locale={currentLocale.code}
    />

    <!-- self-hosted fonts (@font-face in styles/fonts.css); preload the faces that
         paint above the fold — the .h-hero display face + the nav/heading weight. -->
    <link rel="preload" href="/assets/fonts/chakra-petch-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/chakra-petch-600.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />
    <script is:inline>
      //Restore the persisted skin (data-theme) before first paint to avoid a flash.
      //Only the theme is dynamic; the rest of the art direction is baked as fixed
      //data-* attributes on <html> above (atmos + ad slots are env-driven via
      //config/artDirection; brass/density/table/badge/radar are design constants).
      //Kept inline because is:inline scripts cannot import a module.
      (() => {
        try {
          let t = null;
          try {
            t = localStorage.getItem('ranklock-theme');
          } catch {
            /* private mode / disabled storage */
          }
          //default 'foundry' already on <html>; the shipped skins + the styleguide-only
          //ones are the valid set.
          const themes = ['foundry', 'arcane', 'aether', 'gaslamp', 'obsidian'];
          if (t && themes.includes(t)) document.documentElement.dataset.theme = t;
        } catch {
          /* ignore storage access errors (private mode / disabled cookies) */
        }
      })();
    </script>
  </head>
  <body>
    <div class="app-bg" aria-hidden="true"></div>
    {
      /* Rotating hero-art backdrop — the data-atmos="hero" parameter, gated by the
         PUBLIC_HERO_BACKDROP env var (config/artDirection). When off, the island is
         not mounted at all (no roster preloads, no timer) and data-atmos="off" on
         <html>. SSR renders the first hero (no flash / works without JS); the island
         cycles the roster on the client. Decorative + behind all content. */
      ATMOS === 'hero' && <HeroBackdrop client:idle hero={backdropHero} />
    }
    {chrome && <SiteHeader />}
    <slot />
    {
      /* Site-wide sponsor slot above the footer, gated by PUBLIC_AD_SLOTS
         (config/artDirection). AdSlot shows the gaslamp "Sponsored" placeholder
         until a publisher id + an ad-unit slot id exist; becomes a real AdSense
         unit after (ads consent belongs to Google's CMP, not the site banner). */
      chrome && AD_SLOTS === 'on' && (
        <div class="container" style="padding:8px 24px 24px;">
          <AdSlot kind="leaderboard" client:load />
        </div>
      )
    }
    {
      /* Left + right sponsor rails flanking the centered content column, gated by
         the SAME PUBLIC_AD_SLOTS flag as the footer slot above. They're position:fixed
         in the side gutters (components.css .ad-rail), so the content column never
         reflows; a min-width:1736px media query shows them exactly when they fit,
         incl. under the >=1920px wide-zoom (base.css). Same AdSlot
         placeholder, vertical 'skyscraper' kind. */
      chrome && AD_SLOTS === 'on' && (
        <Fragment>
          <div class="ad-rail left">
            <AdSlot kind="skyscraper" client:load />
          </div>
          <div class="ad-rail right">
            <AdSlot kind="skyscraper" client:load />
          </div>
        </Fragment>
      )
    }
    {chrome && <SiteFooter />}
    <!-- Consent + analytics layer — global on EVERY page (incl. chrome=false).
         TrackingProvider is behavior-only (renders null): banner-gated Matomo +
         SPA route-change pageviews + the Consent Mode v2 baseline. ConsentBanner
         is the gaslamp cookie banner (analytics only — ads consent belongs to
         Google's CMP). Both are client:load (the eslint client:* guard enforces
         the directive). Matomo never loads without the analytics grant. -->
    <TrackingProvider client:load />
    <ConsentBanner client:load />
  </body>
</html>
