---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemsTable from '../components/react/ItemsTable';
import ItemsFilterBar from '../components/react/item/ItemsFilterBar';
import ItemsSortPresets from '../components/react/item/ItemsSortPresets';
import { api } from '../lib/apiClient';
import { buildFetch, buildFetchNonEmpty } from '../lib/buildData';
import { breadcrumbJsonLd } from '../lib/seo';
import { dayDate, shortDate } from '../lib/format';
import itemDetail from '../data/items-detail.json';
import type { DataHorizonResponse, HeroSummary, ItemModifier, ItemStat, Patch } from '../types/api';

//SSG items index. Build-time rows (all ranks) seed the island for SEO; the rank bar
//refetches per band client-side. The bake-empty guard fails the build if this bake
//comes back empty (ALLOW_EMPTY_STATS_BUILD=1 to override) — a cold origin must not
//silently ship an empty items table.
const items = await buildFetchNonEmpty<ItemStat>(api.getItems(), '/items/stats (items table)');
//Shop catalog: the slot/tier/cost behind the category nav and the row sub-line.
const catalog = await buildFetch(api.getItemModifiers(), [] as ItemModifier[]);
//Names + portraits for the "Most bought on" medallion; mode-agnostic, so Normal is enough.
const heroes = (await buildFetch(api.getHeroes({ game_mode: 'Normal' }), [] as HeroSummary[])).map((h) => ({
  hero_id: h.hero_id,
  hero_name: h.hero_name,
  icon_url: h.icon_url,
}));

const horizon = await buildFetch(api.getDataHorizon(), null as DataHorizonResponse | null);
const statsThrough = shortDate(horizon?.max_match_start_time);
const patches = await buildFetch(api.getPatches(), [] as Patch[]);
const latestPatch = patches.find((p) => p.is_current)?.patch_id ?? patches[0]?.patch_id ?? null;

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Items', path: '/items' },
]);
const path = Astro.url.pathname;

//Every item that has a detail page, as server-rendered links. The island's table only
//holds the mode and band it fetched, so Street Brawl items and upstream-disabled ones
//are otherwise reachable from the sitemap alone.
type CatalogItem = { name: string; slot: string; tier: number; cost: number };
const allItems = Object.entries(itemDetail as Record<string, CatalogItem>)
  .map(([id, it]) => ({ id, ...it }))
  .sort((a, b) => a.tier - b.tier || a.name.localeCompare(b.name));
//Brawl items are priced 9999: they are not buyable in the normal shop.
const BRAWL_COST = 9999;
const slotGroups = [
  { label: 'Weapon', items: allItems.filter((it) => it.slot === 'weapon' && it.cost !== BRAWL_COST) },
  { label: 'Vitality', items: allItems.filter((it) => it.slot === 'vitality' && it.cost !== BRAWL_COST) },
  { label: 'Spirit', items: allItems.filter((it) => it.slot === 'spirit' && it.cost !== BRAWL_COST) },
  { label: 'Street Brawl', items: allItems.filter((it) => it.cost === BRAWL_COST) },
].filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Deadlock item win rates by rank | RankLock"
  description="Every Deadlock item ranked by win rate, with average buy time and the ranked games it was bought in, filtered by rank tier, slot and tier."
  canonicalPath="/items"
  jsonLd={jsonLd}
  backdrop={false}
>
  <ItemsFilterBar
    currentPath={path}
    patch={latestPatch}
    through={dayDate(horizon?.max_match_start_time) || null}
    client:load
  />

  <main class="container itemsx-main">
    <div class="page-head itemsx-page-head">
      <div>
        <div class="kicker">Shop</div>
        <h1 class="h-page">Items</h1>
        <p class="itemsx-intro">
          Every buildable item with how often it is bought, when, on whom, and how often the buyer wins. Rank
          means badge tier.
        </p>
      </div>
      <ItemsSortPresets client:load />
    </div>

    <ItemsTable
      initialRows={items}
      initialCatalog={catalog}
      heroes={heroes}
      statsThrough={statsThrough}
      client:load
    />

    <section class="panel panel-pad" style="margin-top:20px;">
      <h2 class="h-sec" style="margin-bottom:4px;">Every item, by slot</h2>
      <p class="muted" style="font-size:13px; margin:0 0 12px;">
        Each item's own page carries its win rate by rank tier, what it costs, when it is bought and the
        heroes who build it most.
      </p>
      {
        slotGroups.map((g) => (
          <div style="margin-bottom:14px;">
            <h3 class="h-sec h-sec-sm" style="margin-bottom:8px;">{g.label}</h3>
            <div class="flex" style="gap:8px; flex-wrap:wrap;">
              {g.items.map((it) => (
                <a class="chip" href={`/items/${it.id}/`} style="text-decoration:none;">
                  {it.name}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </main>
</BaseLayout>
