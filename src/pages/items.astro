---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemsTable from '../components/react/ItemsTable';
import { api } from '../lib/apiClient';
import { buildFetch, buildFetchNonEmpty } from '../lib/buildData';
import { breadcrumbJsonLd } from '../lib/seo';
import { shortDate } from '../lib/format';
import type { DataHorizonResponse, HeroSummary, ItemModifier, ItemStat } from '../types/api';

//SSG items index (design 01 Items §1-§4). Build-time rows (all ranks) seed the island for
//SEO; the rank bar refetches per band client-side. The bake-empty guard fails the build if
//this bake comes back empty (ALLOW_EMPTY_STATS_BUILD=1 to override) — a cold origin must
//not silently ship an empty items table.
const items = await buildFetchNonEmpty<ItemStat>(api.getItems(), '/items/stats (items table)');
//Shop catalog: the slot/tier/cost behind the §2 category nav and the row sub-line.
const catalog = await buildFetch(api.getItemModifiers(), [] as ItemModifier[]);
//Names + portraits for the §3 "Most bought on" medallion; mode-agnostic, so Normal is enough.
const heroes = (await buildFetch(api.getHeroes({ game_mode: 'Normal' }), [] as HeroSummary[])).map((h) => ({
  hero_id: h.hero_id,
  hero_name: h.hero_name,
  icon_url: h.icon_url,
}));

const horizon = await buildFetch(api.getDataHorizon(), null as DataHorizonResponse | null);
const statsThrough = shortDate(horizon?.max_match_start_time);

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Items', path: '/items' },
]);
const path = Astro.url.pathname;
---

<BaseLayout
  title="Deadlock item win rates by rank | RankLock"
  description="Every Deadlock item ranked by win rate, with average buy time and the ranked games it was bought in, filtered by rank tier, slot and tier."
  canonicalPath="/items"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="page-head">
      <div>
        <div class="kicker">Shop</div>
        <h1 class="h-page">Deadlock item win rates</h1>
      </div>
    </div>
    <p class="page-intro">
      Every buildable item with how often it is bought, when, and how often the buyer wins{
        statsThrough ? `, through ${statsThrough}` : ''
      }. Rank means badge tier, from Initiate to Eternus, never an MMR range. Filter by slot and tier, or open the
      <a href="/heroes/">hero win rates</a>.
    </p>
    <ItemsTable
      initialRows={items}
      initialCatalog={catalog}
      heroes={heroes}
      currentPath={path}
      statsThrough={statsThrough}
      client:load
    />
  </main>
</BaseLayout>
