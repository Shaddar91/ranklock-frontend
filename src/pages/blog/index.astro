---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbJsonLd, SITE_NAME } from '../../lib/seo';
import { shortDate } from '../../lib/format';
import { AD_SLOTS } from '../../config/artDirection';
import AdSlot from '../../components/react/ui/AdSlot';

//SSG guides index (requirements §B.11) — the icy-veins-style SEO surface, built
//from the blog content collection. Card grid of published posts, newest first.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = [
  breadcrumbJsonLd(origin, [
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/blog' },
  ]),
  { '@type': 'Blog', name: `${SITE_NAME} Guides`, url: new URL('/blog/', origin).toString() },
];
---

<BaseLayout
  title="Deadlock guides and strategy | RankLock"
  description="Deadlock hero guides, item builds and fundamentals, each one carrying win rates pulled live from the current patch."
  canonicalPath="/blog"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="kicker">Guides fused with live stats</div>
    <h1 class="h-page">Deadlock guides</h1>
    <p class="page-intro">
      Deadlock hero guides, item builds and laning fundamentals. Each post embeds win rates pulled from the
      current patch rather than quoting a number that ages. The tables behind them live on the
      <a href="/heroes/">hero win rates</a> page.
    </p>

    {
      posts.length === 0 ? (
        <p class="muted" style="margin-top:20px;">No guides published yet.</p>
      ) : (
        <div class="blog-grid" style="margin-top:20px;">
          {posts.map((post, i) => (
            <Fragment>
              <a class="panel blogcard" href={`/blog/${post.id}/`}>
                {post.data.heroImage && (
                  <img class="bc-hero" src={post.data.heroImage} alt="" loading="lazy" decoding="async" />
                )}
                <div class="bc-title">{post.data.title}</div>
                <p class="bc-desc">{post.data.description}</p>
                <div class="between" style="margin-top:auto;">
                  <span class="label-xs" style="font-size:10px;">{shortDate(post.data.pubDate.toISOString())}</span>
                  {post.data.tags.length > 0 && (
                    <div class="blog-tags">
                      {post.data.tags.slice(0, 2).map((t) => (
                        <span class="blog-tag">{t}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
              {
                /* Feed sponsor slot after every 4th card (ads plan C5, blog_feed_mid),
                   full-width row, gated by PUBLIC_AD_SLOTS. Placeholder until ad units exist. */
                i % 4 === 3 && AD_SLOTS === 'on' && (
                  <div style="grid-column:1/-1; display:flex; justify-content:center; margin:6px 0;">
                    <AdSlot kind="banner" client:load />
                  </div>
                )
              }
            </Fragment>
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>
