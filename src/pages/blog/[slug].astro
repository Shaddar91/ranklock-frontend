---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideLiveStats from '../../components/react/GuideLiveStats';
import { getCollection, render } from 'astro:content';
import { breadcrumbJsonLd, SITE_NAME } from '../../lib/seo';
import { shortDate, readingTime } from '../../lib/format';
import { AD_SLOTS } from '../../config/artDirection';
import AdSlot from '../../components/react/ui/AdSlot';

//SSG guide article (requirements §B.11). One prerendered page per post; the
//markdown body renders to static HTML (SEO), and the "live stats in this guide"
//strip is a client:visible island that pulls current win-rates for the heroes/
//items the post references (build-ahead: falls back to plain name chips offline).
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const canonicalPath = `/blog/${post.id}`;
const published = post.data.pubDate.toISOString();
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const url = new URL(canonicalPath, origin).toString();
const minutesRead = readingTime(post.body);

const jsonLd = [
  breadcrumbJsonLd(origin, [
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/blog' },
    { name: post.data.title, path: canonicalPath },
  ]),
  {
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: published,
    dateModified: modified,
    author: { '@type': 'Person', name: post.data.author },
    mainEntityOfPage: url,
    publisher: { '@type': 'Organization', name: SITE_NAME },
    //tags → schema.org keywords (omitted when the post carries none).
    ...(post.data.tags.length > 0 ? { keywords: post.data.tags.join(', ') } : {}),
  },
];

const hasLive = post.data.liveHeroes.length > 0 || post.data.liveItems.length > 0;
---

<BaseLayout
  title={`${post.data.title} — RankLock`}
  description={post.data.description}
  canonicalPath={canonicalPath}
  image={post.data.heroImage}
  ogType="article"
  jsonLd={jsonLd}
  publishedTime={published}
  modifiedTime={modified}
>
  <main class="container">
    <nav class="kicker" style="margin-bottom:14px;">
      <a href="/blog/" style="color:var(--muted);">← All guides</a>
    </nav>
    <article>
      <h1 class="h-page" style="max-width:26ch;">{post.data.title}</h1>
      <div class="flex" style="gap:10px; align-items:center; margin:10px 0 14px; color:var(--muted); font-size:13px;">
        <span>{post.data.author}</span>
        <span aria-hidden="true">·</span>
        <span>{shortDate(published)}</span>
        <span aria-hidden="true">·</span>
        <span>{minutesRead}</span>
      </div>

      {
        post.data.tags.length > 0 && (
          <div class="blog-tags" style="margin-bottom:22px;">
            {post.data.tags.map((t) => (
              <span class="blog-tag">{t}</span>
            ))}
          </div>
        )
      }

      {
        hasLive && (
          <div class="panel panel-pad" style="margin-bottom:22px;">
            <div class="label-xs" style="margin-bottom:10px;">Live stats in this guide</div>
            <GuideLiveStats heroes={post.data.liveHeroes} items={post.data.liveItems} client:visible />
          </div>
        )
      }

      {
        /* In-article sponsor slot after the post header, before the body (ads plan
           C5, blog post), gated by PUBLIC_AD_SLOTS. Placeholder until ad units exist. */
        AD_SLOTS === 'on' && (
          <div style="margin:0 0 22px; display:flex; justify-content:center;">
            <AdSlot kind="banner" client:load />
          </div>
        )
      }
      <div class="prose">
        <Content />
      </div>
      {
        /* Second in-article slot after the body (the between-sections intent; per-h2
           interleaving would need a rehype pass over the markdown AST — follow-up). */
        AD_SLOTS === 'on' && (
          <div style="margin:22px 0 0; display:flex; justify-content:center;">
            <AdSlot kind="rect" client:load />
          </div>
        )
      }
    </article>
  </main>
</BaseLayout>
