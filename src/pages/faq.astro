---
//FAQ page — real reader questions about how the stats work, answered from the
//same definitions as /methodology. The JSON-LD FAQPage is built from the same
//array the page renders, so markup and schema cannot drift apart.
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '../lib/seo';

const LAST_UPDATED = '2026-09-20';

const faqs = [
  {
    q: 'Where does RankLock get its data?',
    a: `From match data published by the public <a href="https://deadlock-api.com" target="_blank" rel="noopener noreferrer">deadlock-api</a> project. RankLock loads those matches in bulk and computes every aggregated stat itself. The <a href="/methodology/">methodology page</a> lists the exact definitions.`,
  },
  {
    q: 'What counts as a competitive match?',
    a: `The 6v6 competitive queue. In the upstream data that queue is stored as <code>match_mode = 'Unranked'</code> and no separate <code>'Ranked'</code> value exists, so every aggregated stat on the site is computed with exactly that filter.`,
  },
  {
    q: 'What does the rank on a stat page actually mean?',
    a: `The player's own Valve rank: the display rank each player held when they entered a ranked match, as the match data records it, for ranked matches from 7 Aug 2026 on. It is stored as a badge number, tier times 10 plus the subrank, on one 11 to 116 scale. A player's own rank is the rank from their latest ranked match. No stat on RankLock is computed from raw MMR.`,
  },
  {
    q: 'What about unranked matches, or matches before 7 Aug 2026?',
    a: `They carry no per-player rank, so they count only in the "All ranks" view, which includes every player. Until 31 Jul 2026 the upstream data carried one team-average badge per match instead; that basis is retired and drives no rank cohort on the site.`,
  },
  {
    q: 'Does RankLock use MMR?',
    a: `No. Raw MMR is never stored or served; only the Valve rank badge exists. The per-day MMR history endpoint still answers but is empty for most accounts, because the upstream MMR feed no longer delivers data. Player pages show the last 1,000 matches with a rank instead.`,
  },
  {
    q: `How is a hero's win-rate calculated?`,
    a: `As the share of player-slots the hero won: wins over appearances, rounded to one decimal. A 6v6 match produces twelve player-slots. A 54.2% win-rate means the hero won 54.2% of the player-slots it occupied within the group you are viewing.`,
  },
  {
    q: 'How is pick-rate calculated, and why can it pass 100%?',
    a: `On patch pages, pick-rate divides a hero's appearances by the number of distinct matches in the group. Both teams can pick the same hero in one match and each pick counts, so the scale runs from 0 to 2. A hero picked by both teams in every match would show 200%.`,
  },
  {
    q: `Why is a hero's patch win-rate sometimes missing?`,
    a: `It is suppressed on purpose. When a hero has fewer than 20 appearances in a group, the API returns no value instead of a percentage, because samples that small swing wildly. The movers list on a patch page compares each hero against the immediately previous patch by release date.`,
  },
  {
    q: 'How does RankLock decide which patch a match belongs to?',
    a: `By start time. A match belongs to the patch that was live when it began. Its start time falls inside that patch's release-to-end window. One patch is open at a time and covers matches up to the present, and a match never moves to another patch retroactively.`,
  },
  {
    q: 'What do the rank brackets on matchup pages mean?',
    a: `Five brackets of the player's own rank, badge ranges 11 to 36, 41 to 56, 61 to 76, 81 to 96 and 101 to 116, plus an all-ranks view. The API labels them with the game's rank names. The lowest runs Initiate to Acolyte, the highest Ascendant to Eternus. Filtering matchups by bracket constrains the rank of the player on the hero you are viewing from, not the opponent's.`,
  },
  {
    q: 'How often do the stats update?',
    a: `In bursts, when the aggregation pipeline runs. Each run covers the window from the last completed run to the current hour. There is no fixed daily or weekly recompute. The six-hour timer behind it is currently switched on by hand. Every analytics response carries an <code>X-Data-Fresh-As-Of</code> header, and the <a href="https://api.ranklock.app/api/meta/data-horizon" target="_blank" rel="noopener noreferrer">data horizon endpoint</a> shows the newest match in the database.`,
  },
  {
    q: 'Why does a page sometimes say "computing" or warn that data is stale?',
    a: `A route whose dataset has never been computed answers "computing" rather than inventing a number. Data that is older than its freshness threshold, twelve hours for matchup stats and 48 hours for daily and lane datasets, is flagged with an <code>X-Data-Stale: true</code> response header instead of being passed off as fresh.`,
  },
  {
    q: 'What does the rank distribution page count?',
    a: `<a href="/rank-distribution/">Rank distribution</a> counts ranked player-games, not distinct players, at one fixed point in match time (the three-minute mark), grouped by the Valve rank each player held when they entered that match. A player who finished twenty ranked matches in the window is counted twenty times, once per match.`,
  },
  {
    q: 'Where do item stats, counters and synergies come from?',
    a: `Two different places. Item win-rates per hero and per rank are computed by RankLock from its own match data, on the player's own rank. Item stats by rank bracket on the items page, hero counters and hero synergies are proxied from deadlock-api's analytics service, not computed from RankLock data; the rank filter there is the match's average rank, and the page says so.`,
  },
  {
    q: 'Can I compare my economy against higher-ranked players?',
    a: `Yes. Lane Lab draws the 25th, 50th and 75th percentile net-worth curves for players at any Valve rank you pick, ranked games from 7 Aug 2026 on, and puts your own per-minute curve on the same axis. The profile page's soul curve compares against a player-rank league the same way.`,
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = [
  breadcrumbJsonLd(origin, [
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq' },
  ]),
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: stripHtml(f.a) },
    })),
  },
];
---

<BaseLayout
  title="Deadlock stats FAQ | RankLock"
  description="Where RankLock's Deadlock numbers come from, how win rates and rank tiers are defined, how often they refresh, and why some stats are missing."
  canonicalPath="/faq"
  jsonLd={jsonLd}
>
  <main class="container" style="padding-top:40px; padding-bottom:64px;">
    <div class="legal">
      <div class="kicker" style="margin-bottom:10px;">Last updated · {LAST_UPDATED}</div>
      <h1 class="h-hero" style="font-size:clamp(32px,5vw,48px); margin-bottom:14px;">Deadlock stats FAQ</h1>
      <p style="font-size:16px; color:var(--text-2); max-width:72ch; margin-bottom:8px;">
        Answers about the Deadlock numbers on RankLock: where they come from, what a
        rank tier means, and why some stats are missing. The full definitions live on
        the <a href="/methodology/">methodology page</a>.
      </p>
      {
        faqs.map((f) => (
          <>
            <h2>{f.q}</h2>
            <p set:html={f.a} />
          </>
        ))
      }
    </div>
  </main>
</BaseLayout>
