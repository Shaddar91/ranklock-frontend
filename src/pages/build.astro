---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuildLabIsland from '../components/react/BuildLabIsland';
import { api } from '../lib/apiClient';
import { buildFetch } from '../lib/buildData';
import { releasedRoster } from '../lib/heroRoster';
import { slugRoster } from '../lib/heroSlugs';
import { publishedGuideSlugs } from '../lib/guideRoutes';
import type { HeroSummary } from '../types/api';

//Shared-build landing SHELL: a noindex surface for `#b1:<payload>` share links, kept
//off the indexable /build-lab meta page. The per-build OG card is deferred, so og:image
//stays the generic default; the island reads the fragment and names the hero in the tab.

//Same released-roster guard /build-lab hands the island — its "how to play" links are
//keyed on it, not on the /heroes/base-stats roster it fetches itself.
const released = releasedRoster(await buildFetch(api.getHeroes(), [] as HeroSummary[]), 'build');
const guideSlugs = await publishedGuideSlugs();
const roster = slugRoster(
  released.filter((h) => h.hero_id != null),
  'build',
).map((h) => ({ hero_id: h.hero_id, slug: h.slug, hasGuide: guideSlugs.has(h.slug) }));
---

<BaseLayout
  title="Shared build — RankLock"
  description="Open a shared Deadlock build in the RankLock creator — its items, imbues, conditionals and calculated Weapon, Vitality and Spirit stats, souls cost included."
  noindex={true}
>
  <main class="container">
    <div class="kicker">Theorycraft</div>
    <h1 class="h-page">Shared build</h1>
    <p class="page-intro">
      A build shared from the RankLock creator. Tweak it and read its calculated Weapon, Vitality and Spirit stats and
      souls cost, then open the full <a href="/build-lab/">Build Lab</a> to theorycraft your own.
    </p>
    <div style="margin-top:20px;">
      <BuildLabIsland client:load roster={roster} />
    </div>
  </main>
</BaseLayout>
