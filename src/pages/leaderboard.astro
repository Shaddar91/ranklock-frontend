---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeaderboardTable from '../components/react/LeaderboardTable';
import { LEADERBOARD_PAGE_SIZE } from '../lib/leaderboardPager';
import GameModeToggle from '../components/react/ui/GameModeToggle';
import { api } from '../lib/apiClient';
import { buildFetch } from '../lib/buildData';
import { breadcrumbJsonLd } from '../lib/seo';
import { AD_SLOTS } from '../config/artDirection';
import AdSlot from '../components/react/ui/AdSlot';
import type { LeaderboardEntry } from '../types/api';

//SSG leaderboard (requirements §B.1) — top-3 podium + ranked table. Build-time
//rows seed the island so the server render holds the real ladder (SEO without
//JS). Fetch page 1 of the default band (all ranks, offset 0) at the island's
//page size, so these rows match — and seed — React Query's default-page key. The
//rank-band filter + paging are server-driven (min_badge/max_badge + offset).
const { rows: initialRows } = await buildFetch(
  api.getLeaderboard({ limit: LEADERBOARD_PAGE_SIZE }),
  { rows: [] as LeaderboardEntry[], total: null },
);

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Leaderboard', path: '/leaderboard' },
]);
const path = Astro.url.pathname;
---

<BaseLayout
  title="Leaderboard — top Deadlock players | RankLock"
  description="The global Deadlock ranked ladder — the highest-ranked players by rank and total wins."
  canonicalPath="/leaderboard"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="page-head">
      <div>
        <div class="kicker">Global ranked ladder</div>
        <h1 class="h-page">Leaderboard</h1>
      </div>
      {/* Mode filter for this page's mode-separated table; GameModeToggle documents why it sits here, not the nav. */}
      <GameModeToggle currentPath={path} client:load />
    </div>
    <p class="page-intro">
      The highest-ranked Deadlock players, with a podium for the top three. Filter by rank band — emblems, not MMR.
    </p>
    {
      /* In-content sponsor slot above the ladder table (ads plan C5, leaderboard_top),
         gated by PUBLIC_AD_SLOTS like the site-wide slots. Placeholder
         until a publisher id + ad-unit id exist — never a live ad in LOCAL dev. */
      AD_SLOTS === 'on' && (
        <div style="margin-top:20px; display:flex; justify-content:center;">
          <AdSlot kind="banner" client:load />
        </div>
      )
    }
    <div style="margin-top:20px;">
      <LeaderboardTable initialRows={initialRows} client:load />
    </div>
  </main>
</BaseLayout>
