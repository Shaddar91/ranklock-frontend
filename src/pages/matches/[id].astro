---
import BaseLayout from '../../layouts/BaseLayout.astro';

//Per-match page: a CSR body shell (the match-detail island lands in C5). The
//per-match OG share card (<meta og:image> served by `ranklock-dynamic`, §9.1) is
//a SEPARATE pulsar plan (ranklock-og-card-*); generic OG meta is added in C7.
//This scaffold adds NO Cloudflare Worker / prerender=false route — the build
//stays 100% static. getStaticPaths emits one placeholder shell so the route builds.
export function getStaticPaths() {
  return [{ params: { id: 'example' } }];
}
---

<BaseLayout title="Match — RankLock">
  <main class="wrap">
    <p class="kicker">Match</p>
    <h1 class="h-hero">Match detail</h1>
    <p class="muted">Match detail is a CSR island (built in C5).</p>
  </main>
</BaseLayout>
