---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { api } from '../../lib/apiClient';
import { buildFetch } from '../../lib/buildData';
import { breadcrumbJsonLd } from '../../lib/seo';
import MatchesFilterIsland from '../../components/react/MatchesFilterIsland';
import { recentMatchesParams } from '../../lib/matchesPager';
import type { MatchRow } from '../../types/api';

//SSG seed = page 1 of the island's default filters (Normal, any ranked state) so the
//static HTML and the default queryKey line up; every other page/filter fetches live.
const seed = await buildFetch(api.getRecentMatches(recentMatchesParams(1, 'normal', 'any')), {
  rows: [] as MatchRow[],
  total: null as number | null,
});

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Matches', path: '/matches' },
]);
---

<BaseLayout
  title="Recent Deadlock matches and scoreboards | RankLock"
  description="The latest tracked Deadlock matches with team rank, mode, duration and result. Open any match for the full scoreboard and souls breakdown."
  canonicalPath="/matches"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="kicker">Recent games</div>
    <h1 class="h-page">Recent Deadlock matches</h1>
    <p class="page-intro">
      The latest tracked Deadlock matches with team rank, mode, duration and result. Open a match for the full
      scoreboard and the souls breakdown per player. For the aggregate the same matches roll up into, open the
      <a href="/heroes/">hero win rates</a>.
    </p>

    <div style="margin-top:20px;">
      <MatchesFilterIsland initialRows={seed.rows} initialTotal={seed.total} client:load />
    </div>
  </main>
</BaseLayout>
