---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { api } from '../../lib/apiClient';
import { buildFetch } from '../../lib/buildData';
import { breadcrumbJsonLd } from '../../lib/seo';
import MatchesFilterIsland from '../../components/react/MatchesFilterIsland';
import type { MatchRow } from '../../types/api';

//SSG recent matches (requirements §B.6) — static rows baked at build time.
//The React island handles the Normal/Brawl/All toggle with client-side filtering.
//Per-match detail (/matches/:id) is the CSR island (C5). Build-ahead: empty-state on a cold API.
const matches = await buildFetch(api.getRecentMatches(), [] as MatchRow[]);

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Matches', path: '/matches' },
]);
---

<BaseLayout
  title="Recent Deadlock matches — RankLock"
  description="The latest Deadlock matches with team rank, game mode, duration and result. Open any match for a full scoreboard and economy breakdown."
  canonicalPath="/matches"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="kicker">Recent games</div>
    <h1 class="h-page">Recent matches</h1>
    <p class="page-intro">
      The latest tracked Deadlock matches with team rank, mode, duration and result. Open a match for the full
      scoreboard and economy breakdown.
    </p>

    <div style="margin-top:20px;">
      {
        matches.length === 0 ? (
          <div class="panel" style="padding:24px;">
            <p class="muted">No data was available when this page was built.</p>
          </div>
        ) : (
          <MatchesFilterIsland matches={matches} client:load />
        )
      }
    </div>
  </main>
</BaseLayout>
