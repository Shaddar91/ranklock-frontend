---
import BaseLayout from '../layouts/BaseLayout.astro';
import LaneLabIsland from '../components/react/LaneLabIsland';
import { breadcrumbJsonLd } from '../lib/seo';
import { api } from '../lib/apiClient';
import { buildFetch } from '../lib/buildData';
import { shortDate } from '../lib/format';
import type { DataHorizonResponse } from '../types/api';

//Lane Lab. The head is SSG for SEO; everything below it is ONE React island that
//reads the lane endpoints at runtime and never white-screens when they are gated off.
const horizon = await buildFetch(api.getDataHorizon(), null as DataHorizonResponse | null);
const statsThrough = shortDate(horizon?.max_match_start_time);

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Lane Lab', path: '/lane-lab' },
]);
---

<BaseLayout
  title="Lane Lab — compare players minute by minute | RankLock"
  description="Put up to four Deadlock players on one axis and compare souls, damage, kills, deaths and accuracy minute by minute against the players at your rank."
  canonicalPath="/lane-lab"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="kicker">Coaching</div>
    <h1 class="h-page">Lane Lab</h1>
    <p class="page-intro">
      Add yourself and your friends and see who farms, fights and lands shots better, minute by
      minute, against the players at your rank.
      {statsThrough && ` Games through ${statsThrough}.`} For the hero side of the same window, open
      the <a href="/heroes/">hero win rates</a>.
    </p>
    <LaneLabIsland client:load />
  </main>
</BaseLayout>
