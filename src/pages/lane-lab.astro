---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataAgeChip from '../components/react/DataAgeChip';
import LaneLabIsland from '../components/react/LaneLabIsland';
import { breadcrumbJsonLd } from '../lib/seo';

//Lane Lab (brief §7B — the signature economy-curve coaching surface). The static
//chrome (page-header + intro copy) is SSG for SEO; the data surface is ONE React
//island (LaneLabIsland) hydrated client-side that fetches the rich-analytics lane
//endpoints (/lane-lab/economy-curve + /lane-lab/early-econ-verdict) at runtime.
//client:visible defers the Recharts bundle until the curve scrolls into view, so
//the page stays inside the perf budget. The island empty-states (keeping the
//"coming soon" copy) until RICH_ANALYTICS_ENABLED is on and the lane producers
//have run — it never white-screens (requirements §8.1).
const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Lane Lab', path: '/lane-lab' },
]);
---

<BaseLayout
  title="Deadlock Lane Lab — per-minute economy & soul-curve coaching | RankLock"
  description="Lane Lab compares your per-minute souls curve against the rank you're chasing, with a 9-minute early-economy win-rate verdict."
  canonicalPath="/lane-lab"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="kicker">Coaching</div>
    <h1 class="h-page">Lane Lab</h1>
    {/* data-age honesty (Component 11): renders nothing until /meta/data-horizon serves a date */}
    <DataAgeChip client:load />
    <p class="page-intro">
      Per-minute economy and soul-curve coaching — your rank's median souls over match minutes against the
      rank you're chasing, a 9-minute early-economy win-rate verdict, and where the lane is being lost.
    </p>
    <div style="margin-top:20px;">
      <LaneLabIsland client:visible />
    </div>
  </main>
</BaseLayout>
