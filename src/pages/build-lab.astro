---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuildLabIsland from '../components/react/BuildLabIsland';
import { breadcrumbJsonLd } from '../lib/seo';
import { api } from '../lib/apiClient';
import { buildFetch } from '../lib/buildData';
import { releasedRoster } from '../lib/heroRoster';
import { slugRoster } from '../lib/heroSlugs';
import { publishedGuideSlugs } from '../lib/guideRoutes';
import { ASSUMPTIONS, CURVE_WINDOW, THEORETICAL_NOTE } from '../lib/labCalc';
import type { HeroSummary, Patch } from '../types/api';

//Build Lab (requirements §A.4) — wires /heroes/base-stats + /items/modifiers,
//warmed backends with no prior consumer. CSR-only (no build-time seed): the
//hero_base_stats table is empty locally until the patch snapshot hook runs, so
//baking build-time rows would bake an empty/incidental "live" snapshot. The
//island fetches client-side and empty-states until the data is primed (§8.1).
const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Build Lab', path: '/build-lab' },
]);

//The island's own roster comes from /heroes/base-stats, which can name a hero with no page;
//this released roster is what its "how to play" links are keyed on.
const released = releasedRoster(await buildFetch(api.getHeroes(), [] as HeroSummary[]), 'build-lab');
const guideSlugs = await publishedGuideSlugs();
const roster = slugRoster(
  released.filter((h) => h.hero_id != null),
  'build-lab',
).map((h) => ({ hero_id: h.hero_id, slug: h.slug, hasGuide: guideSlugs.has(h.slug) }));

//Design Lab §16 — the calculator contract. The catalog patch is page-level; the hero's
//base-stats snapshot stamps its own patch beside the hero row inside the island.
const catalogPatch = (await buildFetch(api.getCurrentPatch(), null as Patch | null))?.patch_id ?? null;
const labFootnote = [
  'Calculators run in the browser over served payloads: hero base stats and level scaling, ability numbers from the game client, the shop\'s investment table, and item modifiers from the item catalog' +
    (catalogPatch ? ` (patch ${catalogPatch})` : '') +
    '. The application order — base × scale, then flat adds — is locked by golden tests.',
  THEORETICAL_NOTE,
  'Time to kill, burst and their time to kill you render as ranges; effective HP and the per-ability numbers are single figures — neither has a measured band to widen. Every one carries its assumptions beside it.',
  `Affordable-at and the souls timeline: ${CURVE_WINDOW}.`,
  ASSUMPTIONS['pace-factors'],
  'A custom board has no win rate — only served purchase sets and published builds carry one. An imported build keeps its in-game id and its author. Rank means badge tier, never an MMR number.',
].join(' ');
---

<BaseLayout
  title="Deadlock build creator and meta builds | RankLock"
  description="Theorycraft a Deadlock build and read its Weapon, Vitality and Spirit stats live, souls cost included, then share it by link."
  canonicalPath="/build-lab"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="kicker">Lab</div>
    <h1 class="h-page">Build Lab</h1>
    <p class="page-intro">
      Import a build or fill a board, and read its Weapon, Vitality and Spirit stats as you add items,
      imbues and souls cost included, then share it by link. Analyze reads a hero's stats by patch, and
      Community builds lists the trending builds per hero. Calculators are theoretical: no ability resists,
      no falloff, no misses. Outputs with a measured band render as a range, the rest as single figures,
      each with its assumptions. For which items actually win, open the
      <a href="/items/">item win rates</a>.
    </p>
    <div style="margin-top:20px;">
      <BuildLabIsland client:load roster={roster} />
    </div>
    <p class="hero-footnote" style="margin-top:28px;">{labFootnote}</p>
  </main>
</BaseLayout>
