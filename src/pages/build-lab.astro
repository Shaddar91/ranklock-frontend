---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuildLabIsland from '../components/react/BuildLabIsland';
import { breadcrumbJsonLd } from '../lib/seo';

//Build Lab (requirements §A.4) — wires /heroes/base-stats + /items/modifiers,
//warmed backends with no prior consumer. CSR-only (no build-time seed): the
//hero_base_stats table is empty locally until the patch snapshot hook runs, so
//baking build-time rows would bake an empty/incidental "live" snapshot. The
//island fetches client-side and empty-states until the data is primed (§8.1).
const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Build Lab', path: '/build-lab' },
]);
---

<BaseLayout
  title="Deadlock Build Creator & meta builds | RankLock"
  description="Theorycraft Deadlock builds with a live stat calculator — Weapon, Vitality and Spirit panels, imbues, conditionals and souls cost — then share by link. Plus the trending community meta builds, hero base stats and item modifiers."
  canonicalPath="/build-lab"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="kicker">Theorycraft</div>
    <h1 class="h-page">Build Lab</h1>
    <p class="page-intro">
      Build a loadout in the creator and read its calculated Weapon, Vitality and Spirit stats live, imbues and souls
      cost included — then share it by link. See the trending community meta builds per hero, each hero's base stats by
      patch, and every buildable item with its modifiers.
    </p>
    <div style="margin-top:20px;">
      <BuildLabIsland client:load />
    </div>
  </main>
</BaseLayout>
