---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { api } from '../../lib/apiClient';
import { buildFetch, buildFetchNonEmpty } from '../../lib/buildData';
import { heroItemIndex, itemBracketIndex } from '../../lib/buildIndexes';
import { itemNarrative, type ItemHeroRow, type ItemPeer } from '../../lib/itemNarrative';
import { toPct, type Section } from '../../lib/narrative';
import Narrative from '../../components/Narrative.astro';
import WinRate from '../../components/WinRate.astro';
import GameArt from '../../components/GameArt.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { count, pct } from '../../lib/format';
import { resolveAsset } from '../../lib/assets';
import { heroPath } from '../../lib/heroSlugs';
import type { HeroSummary, ItemStat, ItemModifier } from '../../types/api';
import itemDetail from '../../data/items-detail.json';

//Static per-item metadata shape (src/data/items-detail.json, generated by
//scripts/gen-item-catalog.mjs). This file is imported ONLY here (build/server
//frontmatter) so it never enters the client bundle — the client-side items table
//uses the lean name+icon items-catalog.json instead.
interface ItemMetaFull {
  name: string;
  icon: string | null;
  cost: number | null;
  tier: number | null;
  slot: string | null;
  active: boolean | null;
  desc: string | null;
}
type ItemDetail = ItemMetaFull & {
  item_id: number;
  win_rate: number | null;
  matches: number | null;
  players: number | null;
  avg_buy_time_s: number | null;
  avg_buy_time_relative: number | null;
  avg_sell_time_s: number | null;
  avg_sell_time_relative: number | null;
};

interface ModifierEntry {
  property_type: string;
  value: number;
  label: string;
  is_percent: boolean;
}

//SSG item detail — one prerendered page per catalog item id (mirrors heroes/[id].astro).
//The path set comes from the STATIC item catalog (items-detail.json, 251 stable upgrade
//items) so every item always has a page even when /items/stats is cold at build.
//name/icon/cost/tier/slot/description are baked from that catalog; win-rate + matches
//are joined from a build-time /items/stats fetch. The bake-empty guard fails the build
//when that fetch bakes 0 rows (cold origin) instead of silently shipping every item
//page with empty stats — ALLOW_EMPTY_STATS_BUILD=1 overrides for intentional builds.
//If the catalog is somehow empty, a single noindex placeholder keeps the route building.
export async function getStaticPaths() {
  const catalog = itemDetail as unknown as Record<string, ItemMetaFull>;
  const entries = Object.entries(catalog);
  const stats = await buildFetchNonEmpty<ItemStat>(api.getItems(), '/items/stats (item detail pages)');
  const statById = new Map(stats.map((s) => [String(s.item_id), s]));
  const modifiersRaw = await api.getItemModifiers().catch((): ItemModifier[] => []);
  const modifierMap = new Map<number, ModifierEntry[]>(
    modifiersRaw
      .filter((m): m is ItemModifier & { item_id: number } => m.item_id != null)
      .map(m => [m.item_id, (m.modifiers ?? []) as ModifierEntry[]])
  );

  if (entries.length === 0) {
    return [{ params: { id: 'example' }, props: { item: null, modifiers: [], sections: [], heroTable: [] } }];
  }
  const roster = await buildFetch(api.getHeroes(), [] as HeroSummary[]);
  const heroById = new Map(roster.map((h) => [h.hero_id, h]));
  const heroIndex = await heroItemIndex(roster);
  const bracketIndex = await itemBracketIndex();
  //Each hero's own game count in the same feed, so a per-hero share is a share of comparable games.
  const heroFeedGames = new Map<number, number>();
  for (const rows of heroIndex.values())
    for (const r of rows) heroFeedGames.set(r.hero_id, Math.max(heroFeedGames.get(r.hero_id) ?? 0, r.games ?? 0));
  const all = stats.map((s) => ({ item_id: s.item_id, win_rate: s.win_rate ?? null, matches: s.matches ?? s.picks ?? null }));
  const catalogRows = entries.map(([id, meta]) => ({ id: Number(id), meta, st: statById.get(id) }));
  return entries.map(([id, meta]) => {
    const st = statById.get(id);
    //Prefer the LIVE shop-art icon_url (the same /items/stats source the correct list
    //page uses) over the baked catalog glyph. items-detail.json bakes the mono UPGRADE
    //glyph for many items (e.g. Silencer -> emp_bullets.png) whereas the live feed serves
    //the colored shop tile (silencer.webp); this also fills the null-icon handful. The
    //baked meta.icon stays only as the fallback for genuinely-art-less / cold-stats items.
    const icon = resolveAsset(st?.icon_url ?? meta.icon ?? null);
    const item: ItemDetail = {
      item_id: Number(id),
      ...meta,
      icon,
      win_rate: st?.win_rate ?? null,
      matches: st?.matches ?? st?.picks ?? null,
      players: st?.players ?? null,
      avg_buy_time_s: st?.avg_buy_time_s ?? null,
      avg_buy_time_relative: st?.avg_buy_time_relative ?? null,
      avg_sell_time_s: st?.avg_sell_time_s ?? null,
      avg_sell_time_relative: st?.avg_sell_time_relative ?? null,
    };
    const peers: ItemPeer[] = catalogRows
      .filter((r) => r.meta.slot === meta.slot && r.meta.tier === meta.tier)
      .map((r) => ({
        item_id: r.id,
        name: r.meta.name,
        win_rate: r.st?.win_rate ?? null,
        matches: r.st?.matches ?? r.st?.picks ?? null,
        avg_buy_time_s: r.st?.avg_buy_time_s ?? null,
        active: r.meta.active,
      }));
    const heroRows: ItemHeroRow[] = (heroIndex.get(item.item_id) ?? [])
      .filter((r) => r.win_rate != null && (r.games ?? 0) > 0)
      .map((r) => ({
        hero_id: r.hero_id,
        name: heroById.get(r.hero_id)?.hero_name ?? `Hero ${r.hero_id}`,
        games: r.games as number,
        win_rate: r.win_rate as number,
        hero_games: heroFeedGames.get(r.hero_id) ?? null,
      }));
    const sections = itemNarrative({ item, all, peers, heroes: heroRows, brackets: bracketIndex.get(item.item_id) ?? [] });
    const heroTable = [...heroRows].sort((a, b) => b.games - a.games).slice(0, 10);
    return { params: { id }, props: { item, modifiers: modifierMap.get(item.item_id) ?? [], sections, heroTable } };
  });
}

interface Props {
  item: ItemDetail | null;
  modifiers: ModifierEntry[];
  sections: Section[];
  heroTable: ItemHeroRow[];
}
const { item, modifiers, sections, heroTable } = Astro.props;

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const name = item?.name ?? 'Item';
const title = item ? `${name} Deadlock win rate | RankLock` : 'Item — RankLock';
const description = item
  ? item.matches != null
    ? `${name} in Deadlock: win rate over ${count(item.matches)} ranked games, souls cost, average buy time, and the heroes who build it most.`
    : `${name} in Deadlock: win rate, souls cost, average buy time, and the heroes who build it most.`
  : 'Deadlock item detail.';
const canonicalPath = item ? `/items/${item.item_id}` : '/items';
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Items', path: '/items' },
  { name, path: canonicalPath },
]);

//Real shop tiers are 1..4; other values (tier 5, cost 9999) are upstream sentinels for
//unreleased/test items — hide those chips/tiles rather than show a bogus "Tier 5".
const showTier = item?.tier != null && item.tier >= 1 && item.tier <= 4;
const showCost = item?.cost != null && item.cost > 0 && item.cost < 9999;
const slotLabel = item?.slot ? item.slot.charAt(0).toUpperCase() + item.slot.slice(1) : null;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} noindex={!item}>
  <main class="container">
    <nav class="kicker" style="margin-bottom:14px;">
      <a href="/items/" style="color:var(--muted);">← All items</a>
    </nav>

    {
      item ? (
        <div>
          <div class="entity-head">
            <GameArt name={name} src={item.icon} wrapClass="entity-art" fontSize={32} eager />
            <div>
              <div class="kicker">Item · Deadlock{slotLabel ? ` · ${slotLabel}` : ''}</div>
              <h1 class="h-page">{name} win rate and stats</h1>
              <div class="flex" style="gap:6px; margin-top:6px; flex-wrap:wrap;">
                {showTier && <span class="chip">Tier {item.tier}</span>}
                {item.active && <span class="chip">Active</span>}
              </div>
            </div>
          </div>

          <div class="stat-grid" style="margin-bottom:24px;">
            <div class="tile statile">
              <div class="label-xs">Win rate</div>
              <div class="display tnum" style="font-size:26px; font-weight:700; color:var(--win);">
                {item.win_rate == null ? '—' : pct(item.win_rate)}
              </div>
            </div>
            <div class="tile statile">
              <div class="label-xs">Matches</div>
              <div class="display tnum" style="font-size:26px; font-weight:700;">
                {item.matches == null ? '—' : count(item.matches)}
              </div>
            </div>
            {showCost && (
              <div class="tile statile">
                <div class="label-xs">Cost</div>
                <div class="display tnum" style="font-size:26px; font-weight:700; color:var(--gold);">
                  {count(item.cost)}
                </div>
              </div>
            )}
            {showTier && (
              <div class="tile statile">
                <div class="label-xs">Tier</div>
                <div class="display tnum" style="font-size:26px; font-weight:700;">
                  {item.tier}
                </div>
              </div>
            )}
          </div>

          <section class="panel panel-pad" style="margin-bottom:24px;">
            <h2 class="h-sec" style="margin-bottom:6px;">What it does</h2>
            {item.desc ? (
              <p class="muted" style="font-size:14px; margin:0; line-height:1.5;">
                {item.desc}
              </p>
            ) : modifiers.length > 0 ? null : (
              <p class="muted" style="font-size:13px; margin:0;">
                A full description for this item isn't available yet
                {slotLabel ? ` — it's a ${slotLabel.toLowerCase()} slot item` : ''}
                {showCost ? ` costing ${count(item.cost)} souls` : ''}.
              </p>
            )}
            {modifiers.length > 0 && (
              <ul style="list-style:none; margin:8px 0 0; padding:0; display:flex; flex-direction:column; gap:4px;">
                {modifiers.map(m => (
                  <li style="display:flex; justify-content:space-between; font-size:13px;">
                    <span class="muted">{m.label}</span>
                    <span class="tnum">{m.is_percent
                      ? `${m.value > 0 ? '+' : ''}${m.value}%`
                      : `${m.value > 0 ? '+' : ''}${m.value}`
                    }</span>
                  </li>
                ))}
              </ul>
            )}
            {item.win_rate == null && (
              <p class="faint" style="font-size:12px; margin:10px 0 0;">
                No data was available when this page was built.
              </p>
            )}
          </section>
          <Narrative sections={sections} />
          {heroTable.length > 0 && (
            <section class="panel panel-pad" style="margin-bottom:24px;">
              <h2 class="h-sec" style="margin-bottom:10px;">Heroes who build it</h2>
              <div class="dt-scroll">
                <table class="dt">
                  <thead>
                    <tr>
                      <th><span class="th-static">Hero</span></th>
                      <th class="num"><span class="th-static">Games</span></th>
                      <th class="num"><span class="th-static">Win rate</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    {heroTable.map((h) => (
                      <tr>
                        <td>
                          <a class="display" style="font-weight:600; color:var(--text);" href={heroPath(h.name)}>{h.name}</a>
                        </td>
                        <td class="num"><span class="tnum">{count(h.games)}</span></td>
                        <td class="num"><WinRate wr={toPct(h.win_rate)} /></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}
        </div>
      ) : (
        <div>
          <h1 class="h-page">Item stats</h1>
          <p class="page-intro">
            No data was available when this page was built. Browse the <a href="/items/">item win-rate table</a> for the
            full list.
          </p>
        </div>
      )
    }
  </main>
</BaseLayout>
