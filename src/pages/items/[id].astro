---
//SSG item detail — the design's `item` page. One prerendered page per catalog item id;
//the page is generic over [id] and hardcodes no item. Catalog row, /items/stats join,
//component edges, peers and the patch match bake at build time; timing, pairs and
//per-rank rows are client queries because their upstream pages are per-item and large.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameArt from '../../components/GameArt.astro';
import SectionHeader from '../../components/react/ui/SectionHeader';
import StatTile from '../../components/react/ui/StatTile';
import ItemTiming from '../../components/react/item/ItemTiming';
import ItemHeroes from '../../components/react/item/ItemHeroes';
import ItemPatchNotes from '../../components/react/item/ItemPatchNotes';
import ItemRail, { type EdgeView } from '../../components/react/item/ItemRail';
import { api } from '../../lib/apiClient';
import { buildFetch, buildFetchNonEmpty } from '../../lib/buildData';
import { heroItemIndex, itemDetailIndex } from '../../lib/buildIndexes';
import {
  catClass,
  itemTags,
  modifierSummary,
  patchesNamingItem,
  plainItemText,
  rankPeers,
  slotName,
  upgradeDiscount,
  type PeerRow,
} from '../../lib/itemDetail';
import { buyItAgainst, type CounterNote } from '../../lib/itemEditorial';
import { itemTierLabel, itemTierNumeral } from '../../lib/itemTiers';
import { toModifierRows } from '../../lib/itemOverlay';
import { breadcrumbJsonLd } from '../../lib/seo';
import { count, duration, pct } from '../../lib/format';
import { resolveAsset } from '../../lib/assets';
import { heroPath } from '../../lib/heroSlugs';
import type { HeroSummary, ItemDetailResponse, ItemModifier, ItemStat, Patch } from '../../types/api';
import itemCatalog from '../../data/items-detail.json';

interface ItemMetaFull {
  name: string;
  icon: string | null;
  cost: number | null;
  tier: number | null;
  slot: string | null;
  active: boolean | null;
  desc: string | null;
}

interface ItemHead extends ItemMetaFull {
  item_id: number;
  win_rate: number | null;
  matches: number | null;
  players: number | null;
  avg_buy_time_s: number | null;
  avg_sell_time_s: number | null;
  avg_sell_time_relative: number | null;
}

interface HeroRef {
  name: string;
  icon: string | null;
  href: string;
}

export async function getStaticPaths() {
  const catalog = itemCatalog as unknown as Record<string, ItemMetaFull>;
  const entries = Object.entries(catalog);
  if (entries.length === 0) return [];

  const stats = await buildFetchNonEmpty<ItemStat>(api.getItems(), '/items/stats (item detail pages)');
  const statById = new Map(stats.map((s) => [String(s.item_id), s]));
  const modifiers = await buildFetch(api.getItemModifiers(), [] as ItemModifier[]);
  const modifierById = new Map(modifiers.filter((m) => m.item_id != null).map((m) => [m.item_id as number, m]));
  const details = await itemDetailIndex(entries.map(([id]) => Number(id)));
  const patches = await buildFetch(api.getPatches(), [] as Patch[]);
  const roster = await buildFetch(api.getHeroes(), [] as HeroSummary[]);
  const heroIndex = await heroItemIndex(roster);
  const heroes: Record<string, HeroRef> = Object.fromEntries(
    roster.map((h) => [
      String(h.hero_id),
      { name: h.hero_name, icon: resolveAsset(h.icon_url ?? null), href: heroPath(h.hero_name) },
    ]),
  );

  const catalogRows = entries.map(([id, meta]) => {
    const mod = modifierById.get(Number(id));
    return {
      id: Number(id),
      meta,
      stat: statById.get(id),
      slot: mod?.item_slot_type ?? meta.slot ?? null,
      tier: mod?.item_tier ?? meta.tier ?? null,
    };
  });
  const edgeView = (
    edge: { item_id: number; item_name: string; icon_url: string | null },
    role: EdgeView['role'],
  ): EdgeView => {
    const meta = catalog[String(edge.item_id)];
    const mod = modifierById.get(edge.item_id);
    return {
      itemId: edge.item_id,
      name: edge.item_name,
      icon: resolveAsset(edge.icon_url ?? meta?.icon ?? null),
      cost: mod?.cost ?? meta?.cost ?? null,
      slot: mod?.item_slot_type ?? meta?.slot ?? null,
      mods: modifierSummary(mod?.modifiers ?? null),
      role,
    };
  };

  return entries.map(([id, meta]) => {
    const itemId = Number(id);
    const stat = statById.get(id);
    const detail: ItemDetailResponse | null = details.get(itemId) ?? null;
    const mod = modifierById.get(itemId);
    const slot = detail?.item_slot_type ?? mod?.item_slot_type ?? meta.slot;
    const tier = detail?.item_tier ?? mod?.item_tier ?? meta.tier;
    const cost = detail?.cost ?? mod?.cost ?? meta.cost;
    //The live shop tile from /items/stats wins over the baked catalog glyph, which is the
    //mono upgrade art for many items.
    const icon = resolveAsset(stat?.icon_url ?? detail?.shop_image_webp ?? meta.icon ?? null);

    const item: ItemHead = {
      ...meta,
      item_id: itemId,
      icon,
      slot,
      tier,
      cost,
      win_rate: stat?.win_rate ?? null,
      matches: stat?.matches ?? stat?.picks ?? null,
      players: stat?.players ?? null,
      avg_buy_time_s: stat?.avg_buy_time_s ?? null,
      avg_sell_time_s: stat?.avg_sell_time_s ?? null,
      avg_sell_time_relative: stat?.avg_sell_time_relative ?? null,
    };

    const peers: PeerRow[] = rankPeers(
      catalogRows
        .filter((r) => r.slot === (slot ?? null) && r.tier === (tier ?? null))
        .map((r) => ({
          itemId: r.id,
          name: r.meta.name,
          icon: resolveAsset(r.stat?.icon_url ?? r.meta.icon ?? null),
          slot: r.slot,
          winRate: r.stat?.win_rate ?? null,
          matches: r.stat?.matches ?? r.stat?.picks ?? null,
        })),
      itemId,
    );

    const heroFallback = (heroIndex.get(itemId) ?? [])
      .filter((r) => r.win_rate != null && (r.games ?? 0) > 0)
      .sort((a, b) => (b.games ?? 0) - (a.games ?? 0))
      .slice(0, 10)
      .map((r) => ({
        heroId: r.hero_id,
        name: heroes[String(r.hero_id)]?.name ?? `Hero ${r.hero_id}`,
        icon: heroes[String(r.hero_id)]?.icon ?? null,
        href: heroes[String(r.hero_id)]?.href ?? '/heroes/',
        games: r.games as number,
        winRate: (r.win_rate as number) * 100,
      }));

    const components = (detail?.components ?? []).map((e) => edgeView(e, 'Component'));
    return {
      params: { id },
      props: {
        item,
        detail,
        modifiers: (mod?.modifiers ?? detail?.modifiers ?? []) as unknown[],
        components,
        buildsInto: (detail?.builds_into ?? []).map((e) => edgeView(e, 'Builds into')),
        discount: upgradeDiscount(cost, components.map((c) => c.cost)),
        peers,
        heroFallback,
        heroes,
        itemPatches: patchesNamingItem(patches, meta.name),
        against: buyItAgainst(itemId),
      },
    };
  });
}

interface Props {
  item: ItemHead;
  detail: ItemDetailResponse | null;
  modifiers: unknown[];
  components: EdgeView[];
  buildsInto: EdgeView[];
  discount: number | null;
  peers: PeerRow[];
  heroFallback: { heroId: number; name: string; icon: string | null; href: string; games: number; winRate: number }[];
  heroes: Record<string, HeroRef>;
  itemPatches: Patch[];
  against: readonly CounterNote[];
}

const {
  item,
  detail,
  modifiers,
  components,
  buildsInto,
  discount,
  peers,
  heroFallback,
  heroes,
  itemPatches,
  against,
} = Astro.props as Props;

const name = item.name;
const slotLabel = slotName(item.slot);
const tierLabel = itemTierLabel(item.tier);
const crumb = [slotLabel, tierLabel].filter(Boolean).join(' · ');
const peerTitle = [slotLabel, itemTierNumeral(item.tier)].filter(Boolean).join(' ');
const modRows = toModifierRows(modifiers);
const tags = itemTags(modifiers);
const passiveText = plainItemText(detail?.text?.passive ?? detail?.text?.desc ?? item.desc);
const activeText = plainItemText(detail?.text?.active);
const cooldown = detail?.cooldown ?? null;
const showCost = item.cost != null && item.cost > 0;
const selfMods = [modifierSummary(modifiers), detail?.is_active_item ? 'Active' : null].filter(Boolean).join(' · ');
const buySub =
  item.avg_sell_time_s == null
    ? 'minute of purchase'
    : `sold at ${duration(item.avg_sell_time_s)}${item.avg_sell_time_relative == null ? '' : ` · ${item.avg_sell_time_relative.toFixed(0)}% into the match`}`;

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const canonicalPath = `/items/${item.item_id}`;
const title = `${name} Deadlock win rate | RankLock`;
const description =
  item.matches != null
    ? `${name} in Deadlock: win rate over ${count(item.matches)} games, souls cost, when it is bought, and the heroes who build it most.`
    : `${name} in Deadlock: win rate, souls cost, when it is bought, and the heroes who build it most.`;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Items', path: '/items' },
  { name, path: canonicalPath },
]);

const heroNote = 'Share = of that hero’s matches · WR = that hero with the item';
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} backdrop={false}>
  <main class="container itemd-main">
    <nav class="display itemd-crumb" aria-label="Breadcrumb">
      <a href="/items/">Items</a>
      {crumb && <span class="itemd-crumb-sep">/</span>}
      {crumb && <span>{crumb}</span>}
    </nav>

    <section class="itemd-headcard">
      <span class="corner tl"></span>
      <span class="corner br"></span>
      <div class="itemd-headrow">
        <div class="itemd-ident">
          <GameArt name={name} src={item.icon} wrapClass={`itemd-art ${catClass(item.slot)}`} fontSize={24} eager />
          <div class="itemd-identtext">
            <div class="kicker">
              Item{slotLabel ? ` · ${slotLabel}` : ''}{tierLabel ? ` · ${tierLabel}` : ''}
            </div>
            <h1 class="h-page">{name}</h1>
            <div class="itemd-chips">
              {showCost && <span class="chip gold"><span class="mono tnum">{count(item.cost)}</span> souls</span>}
              {
                detail?.is_active_item && (
                  <span class="chip">Active{cooldown != null ? ` · ${cooldown}s cooldown` : ''}</span>
                )
              }
              {tags.map((t) => <span class="chip">{t}</span>)}
            </div>
          </div>
        </div>

        <div class="itemd-tiles">
          <StatTile variant="band" label="Win rate" value={pct(item.win_rate)}>
            <Fragment slot="sub">all heroes · 30 days</Fragment>
          </StatTile>
          <StatTile variant="band" label="Matches" value={count(item.matches)}>
            <Fragment slot="sub">bought in</Fragment>
          </StatTile>
          <StatTile variant="band" label="Players" value={count(item.players)}>
            <Fragment slot="sub">bought it at least once</Fragment>
          </StatTile>
          <StatTile variant="band" label="Avg buy" value={duration(item.avg_buy_time_s)}>
            <Fragment slot="sub">{buySub}</Fragment>
          </StatTile>
        </div>
      </div>
    </section>

    <div class="itemd-grid">
      <div class="itemd-body">
        <section id="what-it-does">
          <SectionHeader
            kicker="What am I buying"
            title="What it does"
            note="Modifiers from the item catalog · text © Valve"
          />
          <div class="itemd-cards">
            <div class="itemd-card itemd-pad">
              <div class="display itemd-cardtitle">Passive</div>
              {
                modRows.map((m) => (
                  <div class="itemd-mod">
                    <span>{m.label ?? m.property_type}</span>
                    <span class="mono tnum itemd-modval">
                      {`${m.value > 0 ? '+' : ''}${Number.isInteger(m.value) ? m.value : m.value.toFixed(1)}${m.is_percent ? '%' : ''}`}
                    </span>
                  </div>
                ))
              }
              {passiveText && <p class="itemd-text">{passiveText}</p>}
              {
                modRows.length === 0 && !passiveText && (
                  <p class="itemd-text muted">The catalog carries no passive modifier or text for this item.</p>
                )
              }
            </div>
            {
              detail?.is_active_item && (
                <div class="itemd-card itemd-pad">
                  <div class="itemd-cardhead">
                    <span class="display itemd-cardtitle">Active</span>
                    {cooldown != null && <span class="mono itemd-cardnote">{cooldown}s cooldown</span>}
                  </div>
                  <p class="itemd-text">
                    {activeText ?? 'The catalog flags an active but carries no text for it.'}
                  </p>
                </div>
              )
            }
          </div>
        </section>

        <ItemTiming client:visible itemId={item.item_id} />

        <ItemHeroes
          client:visible
          itemId={item.item_id}
          fallback={heroFallback}
          note={heroNote}
          heroes={heroes}
        />

        <ItemPatchNotes client:visible itemName={name} initialMatches={itemPatches} />
      </div>

      <ItemRail
        client:visible
        itemId={item.item_id}
        itemName={name}
        itemIcon={item.icon}
        itemSlot={item.slot ?? null}
        itemMods={selfMods}
        cost={item.cost}
        components={components}
        buildsInto={buildsInto}
        discount={discount}
        peers={peers}
        peerTitle={peerTitle || 'this tier'}
        against={against}
      />
    </div>

    <p class="hero-footnote">
      Win rate, matches, players and buy/sell minutes: deadlock-api.com item aggregates, Normal, all ranks, trailing 30
      days. Purchase timing, pairs and the per-rank split carry their own window beside each block. Pick rate is not
      shown: the item feed serves no denominator for one, so the player count stands in its place. No win-rate trend is
      shown either — there is no item-level patch-mover source to measure one against. Category, tier, cost and
      modifiers: the item catalog. Games and win rate per hero: upstream per-hero aggregates until the RankLock
      item-hero fold serves rows. The upgrade discount is assumed, not sourced. "Buy it against" is written by the
      content program, not derived. Rank means badge tier, never an MMR number.
    </p>
  </main>
</BaseLayout>
