---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { api } from '../../lib/apiClient';
import { buildFetch } from '../../lib/buildData';
import { breadcrumbJsonLd } from '../../lib/seo';
import { count, pct } from '../../lib/format';
import type { ItemStat } from '../../types/api';
import itemDetail from '../../data/items-detail.json';

//Static per-item metadata shape (src/data/items-detail.json, generated by
//scripts/gen-item-catalog.mjs). This file is imported ONLY here (build/server
//frontmatter) so it never enters the client bundle — the client-side items table
//uses the lean name+icon items-catalog.json instead.
interface ItemMetaFull {
  name: string;
  icon: string | null;
  cost: number | null;
  tier: number | null;
  slot: string | null;
  active: boolean | null;
  desc: string | null;
}
type ItemDetail = ItemMetaFull & {
  item_id: number;
  win_rate: number | null;
  matches: number | null;
};

//SSG item detail — one prerendered page per catalog item id (mirrors heroes/[id].astro).
//The path set comes from the STATIC item catalog (items-detail.json, 251 stable upgrade
//items) so every item always has a page even when /items/stats is cold at build.
//name/icon/cost/tier/slot/description are baked from that catalog; win-rate + matches are
//joined from a build-time /items/stats fetch (empty-stated when the stats API is cold or
//the win-rate field is still degraded). No backend endpoint — the catalog is self-contained.
//If the catalog is somehow empty, a single noindex placeholder keeps the route building.
export async function getStaticPaths() {
  const catalog = itemDetail as unknown as Record<string, ItemMetaFull>;
  const entries = Object.entries(catalog);
  const stats = await buildFetch(api.getItems(), [] as ItemStat[]);
  const statById = new Map(stats.map((s) => [String(s.item_id), s]));

  if (entries.length === 0) {
    return [{ params: { id: 'example' }, props: { item: null } }];
  }
  return entries.map(([id, meta]) => {
    const st = statById.get(id);
    //Prefer the LIVE shop-art icon_url (the same /items/stats source the correct list
    //page uses) over the baked catalog glyph. items-detail.json bakes the mono UPGRADE
    //glyph for many items (e.g. Silencer -> emp_bullets.png) whereas the live feed serves
    //the colored shop tile (silencer.webp); this also fills the null-icon handful. The
    //baked meta.icon stays only as the fallback for genuinely-art-less / cold-stats items.
    const icon = st?.icon_url ?? meta.icon ?? null;
    const item: ItemDetail = {
      item_id: Number(id),
      ...meta,
      icon,
      win_rate: st?.win_rate ?? null,
      matches: st?.matches ?? st?.picks ?? null,
    };
    return { params: { id }, props: { item } };
  });
}

interface Props {
  item: ItemDetail | null;
}
const { item } = Astro.props;

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const name = item?.name ?? 'Item';
const title = item ? `${name} — win rate, cost & stats | RankLock` : 'Item — RankLock';
const description = item
  ? item.desc
    ? `${name}: ${item.desc}`
    : `${name} Deadlock item stats: win-rate and match volume by rank bracket.`
  : 'Deadlock item detail.';
const canonicalPath = item ? `/items/${item.item_id}` : '/items';
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Items', path: '/items' },
  { name, path: canonicalPath },
]);

//Real shop tiers are 1..4; other values (tier 5, cost 9999) are upstream sentinels for
//unreleased/test items — hide those chips/tiles rather than show a bogus "Tier 5".
const showTier = item?.tier != null && item.tier >= 1 && item.tier <= 4;
const showCost = item?.cost != null && item.cost > 0 && item.cost < 9999;
const slotLabel = item?.slot ? item.slot.charAt(0).toUpperCase() + item.slot.slice(1) : null;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} noindex={!item}>
  <main class="container">
    <nav class="kicker" style="margin-bottom:14px;">
      <a href="/items" style="color:var(--muted);">← All items</a>
    </nav>

    {
      item ? (
        <div>
          <div class="entity-head">
            <span class="entity-art">
              {item.icon ? (
                <img src={item.icon} alt={name} />
              ) : (
                <span class="icon-mono" style="font-size:32px; display:flex; width:100%; height:100%; align-items:center; justify-content:center;">
                  {name.slice(0, 1)}
                </span>
              )}
            </span>
            <div>
              <div class="kicker">Item · Deadlock{slotLabel ? ` · ${slotLabel}` : ''}</div>
              <h1 class="h-page">{name}</h1>
              <div class="flex" style="gap:6px; margin-top:6px; flex-wrap:wrap;">
                {showTier && <span class="chip">Tier {item.tier}</span>}
                {item.active && <span class="chip">Active</span>}
              </div>
            </div>
          </div>

          <div class="stat-grid" style="margin-bottom:24px;">
            <div class="tile statile">
              <div class="label-xs">Win rate</div>
              <div class="display tnum" style="font-size:26px; font-weight:700; color:var(--win);">
                {item.win_rate == null ? '—' : pct(item.win_rate)}
              </div>
            </div>
            <div class="tile statile">
              <div class="label-xs">Matches</div>
              <div class="display tnum" style="font-size:26px; font-weight:700;">
                {item.matches == null ? '—' : count(item.matches)}
              </div>
            </div>
            {showCost && (
              <div class="tile statile">
                <div class="label-xs">Cost</div>
                <div class="display tnum" style="font-size:26px; font-weight:700; color:var(--gold);">
                  {count(item.cost)}
                </div>
              </div>
            )}
            {showTier && (
              <div class="tile statile">
                <div class="label-xs">Tier</div>
                <div class="display tnum" style="font-size:26px; font-weight:700;">
                  {item.tier}
                </div>
              </div>
            )}
          </div>

          <section class="panel panel-pad">
            <h2 class="h-sec" style="margin-bottom:6px;">What it does</h2>
            {item.desc ? (
              <p class="muted" style="font-size:14px; margin:0; line-height:1.5;">
                {item.desc}
              </p>
            ) : (
              <p class="muted" style="font-size:13px; margin:0;">
                A full description for this item isn't available yet
                {slotLabel ? ` — it's a ${slotLabel.toLowerCase()} slot item` : ''}
                {showCost ? ` costing ${count(item.cost)} souls` : ''}.
              </p>
            )}
            {item.win_rate == null && (
              <p class="faint" style="font-size:12px; margin:10px 0 0;">
                Win rate fills in after the next data refresh.
              </p>
            )}
          </section>
        </div>
      ) : (
        <div>
          <h1 class="h-page">Item stats</h1>
          <p class="page-intro">
            Item detail comes online with the stats API. Browse the <a href="/items">item win-rate table</a> for the
            full list.
          </p>
        </div>
      )
    }
  </main>
</BaseLayout>
