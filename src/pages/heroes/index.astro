---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DataAgeChip from '../../components/react/DataAgeChip';
import HeroesTable from '../../components/react/HeroesTable';
import GameModeToggle from '../../components/react/ui/GameModeToggle';
import { api } from '../../lib/apiClient';
import { buildFetch } from '../../lib/buildData';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/seo';
import { shortDate } from '../../lib/format';
import type { DataHorizonResponse, HeroSummary } from '../../types/api';

//SSG heroes meta table (requirements §B.2, the most-visited page). Rows are
//fetched at BUILD time and handed to the island as initialRows, so the island's
//server render bakes the real table into static HTML (SEO without JS); the rank
//bucket filter then refetches client-side. Build-ahead: empty on a cold API.
//
//These are the DEFAULT-mode (Normal) "all ranks" rows — the island seeds React
//Query with them ONLY for the Normal+all-ranks key (see HeroesTable initialData), so
//the no-`?mode` first paint has real rows with no hydration flash; a `?mode=brawl`
//deep-link re-keys to Brawl and fetches fresh instead of reusing this Normal seed.
const heroes = await buildFetch(api.getHeroes({ game_mode: 'Normal' }), [] as HeroSummary[]);
const horizon = await buildFetch(api.getDataHorizon(), null as DataHorizonResponse | null);
const statsThrough = shortDate(horizon?.max_match_start_time);

const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const topNames = [...heroes]
  .filter((h) => h.win_rate != null)
  .sort((a, b) => (b.win_rate ?? 0) - (a.win_rate ?? 0))
  .slice(0, 20)
  .map((h) => h.hero_name);
const jsonLd = [
  breadcrumbJsonLd(origin, [
    { name: 'Home', path: '/' },
    { name: 'Heroes', path: '/heroes' },
  ]),
  itemListJsonLd('Deadlock hero meta', topNames),
];
const description =
  'Every Deadlock hero ranked by win rate, pick share and KDA, filterable by rank tier from Initiate to Eternus.' +
  (statsThrough ? ` Numbers through ${statsThrough}.` : '');
const path = Astro.url.pathname;
---

<BaseLayout
  title="Deadlock hero win rates by rank | RankLock"
  description={description}
  canonicalPath="/heroes"
  jsonLd={jsonLd}
>
  <main class="container">
    <div class="page-head">
      <div>
        <div class="kicker">The meta</div>
        <h1 class="h-page">Deadlock hero win rates</h1>
      </div>
      {/* Mode filter for this page's mode-separated tables; GameModeToggle documents why it sits here, not the nav. */}
      <GameModeToggle currentPath={path} client:load />
    </div>
    {/* data-age honesty (Component 11): renders nothing until /meta/data-horizon serves a date */}
    <DataAgeChip client:load />
    <p class="page-intro">
      Every released Deadlock hero ranked by win rate, pick share and KDA, from ranked
      matches{statsThrough ? ` through ${statsThrough}` : ''}. Pick a rank tier to see the
      same table at your own badge, from Initiate to Eternus. For the same roster grouped
      S to F with the cut for each grade printed, see the
      <a href="/tier-list/">Deadlock tier list</a>, or see how the ranked population itself splits
      by tier on the <a href="/rank-distribution/">rank distribution</a> page.
    </p>
    <div style="margin-top:20px;">
      <HeroesTable initialRows={heroes} client:load />
    </div>
  </main>
</BaseLayout>
