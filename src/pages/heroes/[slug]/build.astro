---
//SSG hero build page — design 01 §Build §1-§6. The phase cards and the buy-order track answer
//the sticky rank filter; the community table carries its own bracket selector because the
//upstream build aggregate splits four ways, not twelve.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GameArt from '../../../components/GameArt.astro';
import HeroBand from '../../../components/hero/HeroBand.astro';
import SectionHeader from '../../../components/react/ui/SectionHeader';
import EmptyState from '../../../components/react/ui/EmptyState';
import HeroFilterBar from '../../../components/react/hero/HeroFilterBar';
import BuildPhases from '../../../components/react/hero/BuildPhases';
import CommunityBuilds from '../../../components/react/hero/CommunityBuilds';
import { api } from '../../../lib/apiClient';
import { buildFetch } from '../../../lib/buildData';
import { dataHorizon, soulsCurve } from '../../../lib/buildIndexes';
import { breadcrumbJsonLd } from '../../../lib/seo';
import { count, pickShare, shortDate } from '../../../lib/format';
import { catalogIndex, situationalGroups, winningSets } from '../../../lib/heroBuild';
import { signatureSlots } from '../../../lib/buildMeta';
import { heroArt } from '../../../lib/heroArt';
import { publishedGuideSlugs } from '../../../lib/guideRoutes';
import { heroPath, slugRoster } from '../../../lib/heroSlugs';
import { releasedRoster } from '../../../lib/heroRoster';
import type {
  AbilityOrdersResponse,
  CommunityBuild,
  HeroAbility,
  HeroAssetsResponse,
  HeroBuildStats,
  HeroItemWinRate,
  HeroSummary,
  ItemModifier,
  ItemStat,
  Patch,
} from '../../../types/api';

export async function getStaticPaths() {
  const heroes = releasedRoster(await buildFetch(api.getHeroes(), [] as HeroSummary[]), 'heroes/[slug]/build');
  if (heroes.length === 0) return [];
  return slugRoster(heroes, 'heroes/[slug]/build').map(({ slug, ...hero }) => ({
    params: { slug },
    props: { hero: hero as HeroSummary, roster: heroes },
  }));
}

const { hero, roster } = Astro.props as { hero: HeroSummary; roster: HeroSummary[] };
const name = hero.hero_name;
const emptyStats: HeroBuildStats = {
  hero_id: hero.hero_id,
  tier: 0,
  match_mode: 'Ranked',
  game_mode: 'Normal',
  item_sets: [],
  buy_order: [],
};

const [assets, itemStats, modifiers, stats, itemWinRates, builds, abilityRows, abilityOrders, currentPatch, curve, horizon] =
  await Promise.all([
    buildFetch(api.getHeroAssets(hero.hero_id), null as HeroAssetsResponse | null),
    buildFetch(api.getItems(undefined, undefined, hero.hero_id), [] as ItemStat[]),
    buildFetch(api.getItemModifiers(), [] as ItemModifier[]),
    buildFetch(api.getHeroBuildStats(hero.hero_id), emptyStats),
    buildFetch(api.getHeroItemWinRates(hero.hero_id), [] as HeroItemWinRate[]),
    buildFetch(api.getHeroBuilds(hero.hero_id, 'weekly', true), [] as CommunityBuild[]),
    buildFetch(api.getHeroAbilities(hero.hero_id), [] as HeroAbility[]),
    buildFetch(api.getAbilityOrders(hero.hero_id), null as AbilityOrdersResponse | null),
    buildFetch(api.getCurrentPatch(), null as Patch | null),
    soulsCurve(),
    dataHorizon(),
  ]);

const catalog = catalogIndex(modifiers);
//Tile props resolve here: an ability entry has no item page to link to, so it renders as a
//plain tile with the ability marker rather than a dead link.
const sets = winningSets(stats.item_sets, catalog).map((s) => ({
  ...s,
  tiles: s.entries.map((e) => ({
    ...e,
    cls: e.shopItem ? 'bp-tile' : 'bp-tile bp-tile-ability',
    href: e.shopItem ? `/items/${e.itemId}/` : undefined,
    title: e.shopItem ? e.name : `${e.name} - ability upgrade`,
  })),
}));
const situational = situationalGroups(modifiers, itemWinRates);

//§5: the two orders the Overview legend explains, recapped here without the legend and
//without a cold gate (design 01 §Build §5).
const slotOfAbility = signatureSlots(abilityRows);
const orders = abilityOrders?.orders ?? [];
const mostPlayed = orders.reduce<(typeof orders)[number] | null>((best, o) => (best && best.matches >= o.matches ? best : o), null);
const bestWinRate = orders.reduce<(typeof orders)[number] | null>((best, o) => (best && best.win_rate >= o.win_rate ? best : o), null);
const skillRows = [
  { label: 'Most played', order: mostPlayed },
  { label: 'Highest win rate', order: bestWinRate },
]
  .filter((r) => r.order != null)
  .map((r) => ({
    label: r.label,
    matches: r.order!.matches,
    winRate: r.order!.win_rate * 100,
    chips: r.order!.abilities.map((id, i) => ({ key: slotOfAbility[String(id)] ?? 0, level: i + 1 })),
  }));

const byPicks = [...roster].sort((a, b) => (b.picks ?? 0) - (a.picks ?? 0));
const patchRank = byPicks.findIndex((h) => h.hero_id === hero.hero_id) + 1;
const pickRate = pickShare(hero.picks, roster.reduce((sum, h) => sum + (h.picks ?? 0), 0));

const heroUrl = heroPath(name);
const canonicalPath = `${heroUrl}build/`;
const hasGuide = (await publishedGuideSlugs()).has(Astro.params.slug as string);
const tabs = [
  { label: 'Overview', href: heroUrl, current: false },
  { label: 'Build', href: canonicalPath, current: true },
  ...(hasGuide ? [{ label: 'How to play', href: `${heroUrl}guide/`, current: false }] : []),
  { label: 'Counters', href: `${heroUrl}#matchups`, current: false },
];

const windowOf = (ds: string) => horizon?.datasets.find((d) => d.dataset === ds);
const setWindow = windowOf('hero-itemset-win-rates');
const setLo = shortDate(setWindow?.window_lo);
const setHi = shortDate(setWindow?.window_hi);
const buyThrough = shortDate(windowOf('item-stats')?.window_hi ?? horizon?.max_match_start_time);

const setsNote =
  `All ranks · sorted by Wilson lower bound${setLo && setHi ? ` · ${setLo} to ${setHi}` : ''}. ` +
  'A set is the six purchases our own matches measured together; the fold counts ability upgrades ' +
  'alongside shop items, so a set can mix both and a repeat shows as ×n.';
const situationalNote =
  `Four modifier families from the item catalog. Inside each, the items with the highest Wilson lower bound on ${name} ` +
  '— RankLock public matches, all ranks. Which enemy to buy them against is not derived and is not shown.';
const skillNote = abilityOrders
  ? `${abilityOrders.source} · ${abilityOrders.window} · orders under ${abilityOrders.min_matches.toLocaleString('en-US')} matches hidden`
  : 'deadlock-api.com ability-order aggregates';

const art = heroArt(hero.icon_url);
const description = `What to buy on ${name} and when: the build by phase, the buy order with its running souls cost, the item sets that win, and the published builds with their 30-day win rate.`;
const origin = (Astro.site ?? new URL('https://ranklock.app')).origin;
const jsonLd = breadcrumbJsonLd(origin, [
  { name: 'Home', path: '/' },
  { name: 'Heroes', path: '/heroes' },
  { name, path: heroUrl },
  { name: 'Build', path: canonicalPath },
]);
---

<BaseLayout
  title={`${name} build, best items by win rate | RankLock`}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  backdropHero={art?.cls}
>
  <HeroBand
    hero={hero}
    assets={assets}
    patchRank={patchRank}
    rosterSize={roster.length}
    pickRate={pickRate}
    tabs={tabs}
  />

  <div class="container">
    <HeroFilterBar currentPath={canonicalPath} client:load />
  </div>

  <main class="container hero-main">
    <BuildPhases
      client:load
      heroId={hero.hero_id}
      initialItemStats={itemStats}
      catalog={[...catalog.values()]}
      curve={curve}
    />

    <section id="sets" class="bp-two">
      <div>
        <SectionHeader
          kicker="Which full sets win"
          title="Winning six-purchase sets"
          note={setsNote}
        />
        {
          sets.length === 0 ? (
            <EmptyState title="Computing" message="No purchase set has been folded for this hero yet. This block refreshes hourly." />
          ) : (
            <div class="panel bp-table">
              <div class="bp-srow bp-bhead">
                <span class="label-xs">Set</span>
                <span class="label-xs num">Games</span>
                <span class="label-xs num">WR</span>
                <span class="label-xs num">Wilson</span>
              </div>
              {sets.map((s) => (
                <div class="bp-srow">
                  <span class="bp-set">
                    {s.tiles.map((e) => (
                      <a class={e.cls} href={e.href} title={e.title}>
                        <GameArt name={e.name} src={e.iconUrl} wrapClass="iicon" wrapStyle="width:30px; height:30px;" />
                        {e.count > 1 && <span class="bp-mult">x{e.count}</span>}
                      </a>
                    ))}
                  </span>
                  <span class="mono tnum num muted">{count(s.games)}</span>
                  <span class="mono tnum num" style={`color:${s.winRate >= 50 ? 'var(--win)' : 'var(--loss)'}`}>
                    {s.winRate.toFixed(1)}%
                  </span>
                  <span class="mono tnum num muted">{s.wilson.toFixed(1)}%</span>
                </div>
              ))}
            </div>
          )
        }
      </div>

      <div>
        <SectionHeader
          kicker="What to swap in"
          title="Situational picks"
          note={situationalNote}
        />
        {
          situational.length === 0 ? (
            <EmptyState title="Computing" message="No item in these families has a measured win rate on this hero yet." />
          ) : (
            <div class="bp-sit">
              {situational.map((g) => (
                <div class="panel panel-pad bp-sit-row">
                  <div>
                    <div class="display bp-sit-label">{g.label}</div>
                    <div class="bp-sit-effect">{g.effect}</div>
                  </div>
                  <div class="bp-sit-picks">
                    {g.picks.map((p) => (
                      <a class="bp-chip" href={`/items/${p.itemId}/`}>
                        <GameArt name={p.name} src={p.iconUrl} wrapClass="iicon" wrapStyle="width:24px; height:24px;" />
                        <span class="bp-chip-text">
                          <span class="display">{p.name}</span>
                          <span class="bp-chip-mod mono">{p.modifier}</span>
                        </span>
                        <span class="mono tnum" style={`color:${p.winRate >= 50 ? 'var(--win)' : 'var(--loss)'}`}>
                          {p.winRate.toFixed(1)}%
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <CommunityBuilds
      client:load
      heroId={hero.hero_id}
      initialBuilds={builds}
      abilitySlots={slotOfAbility}
      currentPatchId={currentPatch?.patch_id ?? null}
      nowSeconds={Math.floor(Date.now() / 1000)}
    />

    <section id="skill-recap">
      <SectionHeader kicker="What to level" title="Skill order" note={skillNote}>
        <a class="kicker" slot="action" href={`${heroUrl}#skill-order`}>
          Both orders with the legend on Overview →
        </a>
      </SectionHeader>
      {
        skillRows.length === 0 ? (
          <EmptyState title="Computing" message="Ability-order stats are still folding. This block refreshes hourly." />
        ) : (
          <div class="panel skill-panel">
            {skillRows.map((row) => (
              <div class="skill-row">
                <div>
                  <div class="display skill-label">{row.label}</div>
                  <div class="mono tnum skill-meta">
                    {count(row.matches)} matches ·{' '}
                    <span style={`color:${row.winRate >= 50 ? 'var(--win)' : 'var(--loss)'}`}>
                      {row.winRate.toFixed(1)}%
                    </span>
                  </div>
                </div>
                <div class="skill-chips">
                  {row.chips.map((c) => (
                    <span class="skill-chip">
                      <span class={`kit-key k${c.key}`}>{c.key || '?'}</span>
                      <span class="mono skill-lvl">{c.level}</span>
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )
      }
    </section>

    <p class="hero-footnote">
      Build, item and ability-order win rates: deadlock-api.com aggregates, trailing 30 days, at the sample floor each
      block names; never RankLock's own matches, which carry no per-match purchases. Buys, buy minutes and the souls
      curve: RankLock public matches{buyThrough ? `, through ${buyThrough}` : ''}. Purchase sets: all ranks until the
      tier axis is folded. A build's title is not a fact; its 30-day column is. Rank means badge tier, never an MMR
      number.
    </p>
  </main>
</BaseLayout>
