---
//SSG canonical "how to play" page, one per published canonical guide file (no `--` in the id),
//via the shared GuidePage renderer. No guide file, no URL — omit, never promise.
import GuidePage from '../../../components/hero/GuidePage.astro';
import { getCollection, getEntry } from 'astro:content';
import { api } from '../../../lib/apiClient';
import { buildFetch } from '../../../lib/buildData';
import { publishedGuides } from '../../../lib/guideRoutes';
import { slugRoster } from '../../../lib/heroSlugs';
import { releasedRoster } from '../../../lib/heroRoster';
import type { HeroSummary } from '../../../types/api';

//Canonical files only — `--` ids are minted by guide/[token].astro; a warm-roster slug miss fails the build by name.
export async function getStaticPaths() {
  const heroes = releasedRoster(await buildFetch(api.getHeroes(), [] as HeroSummary[]), 'heroes/[slug]/guide');
  if (heroes.length === 0) return [];
  const bySlug = new Map(slugRoster(heroes, 'heroes/[slug]/guide').map(({ slug, ...hero }) => [slug, hero as HeroSummary]));
  const guides = (await getCollection('guides', ({ data }) => !data.draft)).filter((g) => !g.id.includes('--'));
  return guides.map((guide) => {
    const hero = bySlug.get(guide.id);
    if (!hero) {
      throw new Error(`[guide-roster guard] src/content/guides/${guide.id}.md: slug "${guide.id}" is not on the released roster.`);
    }
    return { params: { slug: guide.id }, props: { hero, roster: heroes } };
  });
}

const { hero, roster } = Astro.props as { hero: HeroSummary; roster: HeroSummary[] };
const slug = Astro.params.slug as string;

const found = await getEntry('guides', slug);
if (!found || found.data.draft) throw new Error(`[guide guard] /heroes/${slug}/guide/ has no published guide file.`);

const siblings = ((await publishedGuides()).get(slug) ?? []).filter((s) => s.token !== null);
---

<GuidePage hero={hero} roster={roster} entry={found} siblings={siblings} />
